<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Vault | PvP Arena</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="/socket.io/socket.io.js"></script>
    <style>
        ::-webkit-scrollbar { width: 6px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: #6366f1; border-radius: 10px; }
        
        .glass-panel { background: rgba(15, 23, 42, 0.7); backdrop-filter: blur(16px); border: 1px solid rgba(255, 255, 255, 0.08); }
        .terminal-log { max-height: 300px; overflow-y: auto; scroll-behavior: smooth; font-family: monospace; }
        .terminal-log p { border-left: 2px solid #6366f1; padding-left: 8px; margin-bottom: 6px; opacity: 0; animation: fadeIn 0.3s forwards; }
        @keyframes fadeIn { to { opacity: 1; } }
        
        /* 3D Card Animations */
        .card-container { perspective: 1000px; margin: 5px; }
        .playing-card { width: 80px; height: 115px; position: relative; transform-style: preserve-3d; transition: transform 0.6s cubic-bezier(0.4, 0.2, 0.2, 1); cursor: pointer; }
        .playing-card:hover:not(.locked) { transform: translateY(-10px) scale(1.05); box-shadow: 0 15px 25px rgba(99, 102, 241, 0.4); z-index: 20; }
        .card-front, .card-back { position: absolute; width: 100%; height: 100%; backface-visibility: hidden; border-radius: 8px; display: flex; flex-direction: column; align-items: center; justify-content: center; font-size: 24px; font-weight: bold; border: 2px solid rgba(255,255,255,0.1); box-shadow: -2px 4px 10px rgba(0,0,0,0.3); }
        .card-back { background: repeating-linear-gradient(45deg, #1e1b4b, #1e1b4b 10px, #312e81 10px, #312e81 20px); }
        .card-front { background: white; transform: rotateY(180deg); }
        .card-red { color: #ef4444; } .card-black { color: #0f172a; }
        .flipped { transform: rotateY(180deg); }
        .locked { opacity: 0.5; pointer-events: none; }
        
        /* Deal Animation */
        .deal-in { animation: deal 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards; opacity: 0; transform: translateY(-50px) scale(0.5); }
        @keyframes deal { to { opacity: 1; transform: translateY(0) scale(1); } }

        /* UI Pop */
        .pop-in { animation: pop 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards; }
        @keyframes pop { 0% { transform: scale(0.8); opacity: 0; } 100% { transform: scale(1); opacity: 1; } }
    </style>
</head>
<body class="bg-[#0B0F19] text-slate-200 font-sans antialiased min-h-screen p-4 md:p-8 bg-[radial-gradient(ellipse_at_top_right,_var(--tw-gradient-stops))] from-indigo-900/20 via-[#0B0F19] to-[#0B0F19]">

    <div class="max-w-7xl mx-auto space-y-6">
        
        <header class="flex justify-between items-center glass-panel rounded-full px-6 py-4 shadow-xl border-b border-white/5">
            <h1 class="text-xl font-bold text-white tracking-wider flex items-center gap-3">
                <span class="p-2 bg-indigo-500/20 rounded-full text-indigo-400">⚔️</span> PVP ARENA
            </h1>
            <a href="/wallet/portfolio" class="text-sm font-semibold text-slate-300 hover:text-white bg-white/5 hover:bg-white/10 px-6 py-2.5 rounded-full transition-all border border-white/5">Return to Vault</a>
        </header>

        <% if (error) { %>
            <div class="bg-red-500/10 border border-red-500/30 text-red-400 p-4 rounded-2xl flex items-center gap-3 animate-pulse">
                <p class="font-medium">⚠️ <%= error %></p>
            </div>
        <% } %>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6" id="lobby-view">
            
            <div class="lg:col-span-4 glass-panel rounded-[2rem] p-8 relative overflow-hidden">
                <div class="absolute -top-20 -right-20 w-48 h-48 bg-indigo-600/20 rounded-full blur-3xl pointer-events-none"></div>
                
                <h2 class="text-white text-xl font-bold mb-6 flex items-center gap-2">Host Match</h2>
                <form action="/trade/host" method="POST" class="space-y-6 relative z-10">
                    
                    <div class="grid grid-cols-2 gap-4 bg-black/40 p-2 rounded-xl border border-white/5">
                        <label class="cursor-pointer text-center">
                            <input type="radio" name="chain" value="ETH" class="peer sr-only" onchange="updateBalanceUI()" checked>
                            <div class="py-2 rounded-lg text-sm font-bold text-slate-500 peer-checked:bg-indigo-500/20 peer-checked:text-indigo-400 transition-all">Ethereum</div>
                        </label>
                        <label class="cursor-pointer text-center">
                            <input type="radio" name="chain" value="SOL" class="peer sr-only" onchange="updateBalanceUI()">
                            <div class="py-2 rounded-lg text-sm font-bold text-slate-500 peer-checked:bg-emerald-500/20 peer-checked:text-emerald-400 transition-all">Solana</div>
                        </label>
                    </div>

                    <div>
                        <label class="block text-xs font-bold text-slate-400 mb-2 uppercase tracking-wider">Combat Engine</label>
                        <select name="game" class="w-full bg-black/40 border border-white/10 rounded-xl p-4 text-white font-medium outline-none focus:border-indigo-500">
                            <option value="hexa">🎴 Hexa-Guess (Memory/Bluff)</option>
                            <option value="highcard">🃏 High Card (Sudden Death)</option>
                            <option value="war">⚔️ Tactical War (Best of 3)</option>
                        </select>
                    </div>

                    <div>
                        <div class="flex justify-between items-end mb-2">
                            <label class="block text-xs font-bold text-slate-400 uppercase tracking-wider">Wager Amount</label>
                            <span class="text-xs text-indigo-400 font-mono font-bold">Avail: <span id="display-bal">0.00</span></span>
                        </div>
                        <input type="number" id="stake-amt" name="amount" step="any" placeholder="0.00" class="w-full bg-black/40 border border-white/10 rounded-xl p-4 text-white text-lg font-bold outline-none mb-3">
                        <div class="grid grid-cols-3 gap-2">
                            <button type="button" onclick="setFraction(0.25)" class="bg-white/5 hover:bg-white/10 py-2 rounded-lg text-xs font-bold text-slate-300 transition-all">25%</button>
                            <button type="button" onclick="setFraction(0.50)" class="bg-white/5 hover:bg-white/10 py-2 rounded-lg text-xs font-bold text-slate-300 transition-all">50%</button>
                            <button type="button" onclick="setFraction(1.0)" class="bg-indigo-500/20 hover:bg-indigo-500/40 text-indigo-300 py-2 rounded-lg text-xs font-bold transition-all">MAX</button>
                        </div>
                    </div>

                    <div class="space-y-3">
                        <label class="flex items-center gap-3 p-3 bg-black/40 rounded-xl border border-white/5 cursor-pointer hover:bg-black/60 transition-colors">
                            <input type="checkbox" name="isPrivate" class="w-4 h-4 accent-indigo-500 rounded bg-black">
                            <span class="text-sm font-bold text-white">Private Room (Requires Key)</span>
                        </label>
                        <label class="flex items-center gap-3 p-3 bg-black/40 rounded-xl border border-emerald-500/20 cursor-pointer hover:bg-emerald-950/30 transition-colors">
                            <input type="checkbox" name="isPractice" class="w-4 h-4 accent-emerald-500 rounded bg-black">
                            <span class="text-sm font-bold text-emerald-400">Practice Mode (No Risk PVP)</span>
                        </label>
                    </div>

                    <button type="submit" class="w-full bg-gradient-to-r from-indigo-600 to-violet-600 hover:from-indigo-500 hover:to-violet-500 text-white font-bold py-4 rounded-xl shadow-lg transition-transform hover:scale-[1.02]">
                        Initialize Matrix
                    </button>
                </form>
            </div>

            <div class="lg:col-span-8 flex flex-col gap-6">
                <div class="glass-panel rounded-3xl p-6">
                    <form action="/trade/join" method="POST" class="flex gap-4">
                        <input type="text" name="accessKey" required placeholder="Enter Private Access Key..." class="flex-1 bg-black/40 border border-white/10 rounded-xl p-4 text-white uppercase tracking-widest outline-none focus:border-indigo-500 font-mono">
                        <button type="submit" class="bg-slate-800 hover:bg-slate-700 text-white font-bold px-8 rounded-xl transition-all">Join Private</button>
                    </form>
                </div>

                <div class="glass-panel rounded-[2rem] p-8 flex-1">
                    <h2 class="text-white text-2xl font-bold mb-6 flex items-center gap-3">
                        Global Lobbies <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                    </h2>
                    
                    <% if (publicBets && publicBets.length > 0) { %>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <% publicBets.forEach(bet => { %>
                                <div class="bg-black/40 border border-white/5 hover:border-indigo-500/50 rounded-2xl p-6 transition-all group">
                                    <div class="flex justify-between items-start mb-6">
                                        <div>
                                            <span class="px-2 py-1 rounded text-[10px] font-black tracking-widest uppercase <%= bet.isPractice ? 'bg-emerald-500/20 text-emerald-400' : 'bg-indigo-500/20 text-indigo-400' %>">
                                                <%= bet.isPractice ? 'PRACTICE' : bet.hostChain + ' STAKES' %>
                                            </span>
                                            <h3 class="text-white font-bold text-xl mt-2 capitalize"><%= bet.game %></h3>
                                        </div>
                                        <div class="text-right bg-black/50 px-3 py-1.5 rounded-lg border border-white/5">
                                            <p class="text-lg font-black text-white"><%= bet.cryptoAmount %></p>
                                            <p class="text-[10px] text-slate-500 font-bold"><%= bet.hostChain %></p>
                                        </div>
                                    </div>
                                    <form action="/trade/join" method="POST">
                                        <input type="hidden" name="betId" value="<%= bet.id %>">
                                        <button type="submit" class="w-full bg-white/5 group-hover:bg-indigo-600 text-white font-bold py-3 rounded-xl transition-all">Challenge Host</button>
                                    </form>
                                </div>
                            <% }) %>
                        </div>
                    <% } else { %>
                        <div class="flex flex-col items-center justify-center py-20 text-slate-500">
                            <svg class="w-12 h-12 mb-4 opacity-50" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 002-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path></svg>
                            <p class="text-lg font-medium">No open lobbies.</p>
                        </div>
                    <% } %>
                </div>
            </div>
        </div>

        <div id="live-board" class="hidden grid grid-cols-1 lg:grid-cols-12 gap-6">
            
            <div class="lg:col-span-8 glass-panel rounded-[2rem] p-8 min-h-[600px] flex flex-col justify-between relative overflow-hidden">
                <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] from-indigo-900/10 via-transparent to-transparent pointer-events-none"></div>
                
                <div class="text-center z-10">
                    <h2 id="game-title" class="text-2xl font-black text-white uppercase tracking-widest">ARENA</h2>
                    <p id="game-status" class="text-indigo-400 font-bold mt-2 animate-pulse bg-black/40 inline-block px-4 py-1 rounded-full border border-indigo-500/30">Connecting to node...</p>
                </div>

                <div id="game-canvas" class="flex-1 flex flex-col items-center justify-center gap-8 z-10 w-full mt-8">
                    </div>

                <div class="mt-8 text-center z-10 min-h-[60px]" id="action-prompt">
                    </div>
            </div>

            <div class="lg:col-span-4 glass-panel rounded-[2rem] p-6 flex flex-col">
                <h3 class="text-white font-bold mb-4 uppercase text-sm tracking-wider border-b border-white/10 pb-3 flex items-center gap-2">
                    <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span> Event Stream
                </h3>
                <div id="log-container" class="terminal-log flex-1 bg-black/40 rounded-xl p-4 border border-white/5 shadow-inner">
                    </div>
            </div>
        </div>
    </div>

    <script>
        // 1. Fractional Betting Logic
        const myEthAddress = "<%= wallet.ethAddress %>";
        const mySolAddress = "<%= wallet.solAddress %>";
        const balances = { ETH: <%= wallet.balances ? wallet.balances.eth : 0 %>, SOL: <%= wallet.balances ? wallet.balances.sol : 0 %> };

        function updateBalanceUI() {
            const chain = document.querySelector('input[name="chain"]:checked').value;
            document.getElementById('display-bal').innerText = balances[chain].toFixed(4) + ' ' + chain;
            document.getElementById('stake-amt').value = ''; 
        }
        updateBalanceUI();

        function setFraction(perc) {
            const chain = document.querySelector('input[name="chain"]:checked').value;
            document.getElementById('stake-amt').value = (balances[chain] * perc).toFixed(4);
        }

        // 2. Socket.io Core
        const socket = io();
        let currentBetId = null;

        const urlParams = new URLSearchParams(window.location.search);
        if (urlParams.get('join')) {
            joinGame(urlParams.get('join'));
        }

        function joinGame(betId) {
            currentBetId = betId;
            document.getElementById('lobby-view').classList.add('hidden');
            document.getElementById('live-board').classList.remove('hidden');
            socket.emit('join_game', betId);
        }

        socket.on('game_error', (msg) => { alert(msg); window.location.href = '/wallet/trade'; });

        // 3. State Router
        socket.on('update_state', (game) => {
            // Determine "me"
            const myId = game.hostChain === 'SOL' ? mySolAddress : myEthAddress;
            const me = game.players.find(p => p.id === myId);
            const opponent = game.players.find(p => p.id !== myId);

            // Update Logs
            const logBox = document.getElementById('log-container');
            logBox.innerHTML = game.logs.map(l => `<p class="text-emerald-400 text-xs">${l}</p>`).join('');
            logBox.scrollTop = logBox.scrollHeight;

            // Update Status Banner
            const status = document.getElementById('game-status');
            document.getElementById('game-title').innerText = `${game.game.toUpperCase()} PROTOCOL`;
            
            if (game.state === 'waiting') status.innerText = "WAITING FOR CHALLENGER...";
            else if (game.state === 'resolving') status.innerText = "RESOLVING COMBAT...";
            else if (game.state === 'finished') status.innerText = game.winner === myId ? "VICTORY ACHIEVED" : "DEFEAT";
            else status.innerText = "ACTIVE COMBAT PHASE";

            if (!me) return;

            // Route to correct renderer
            if (game.game === 'hexa') renderHexa(game, me, opponent);
            if (game.game === 'highcard') renderHighCard(game, me, opponent);
            if (game.game === 'war') renderWar(game, me, opponent);
        });

        // --- Card Generator Helper ---
        function getCardHTML(c, id, onClickFn, extraClass='') {
            if (!c) return `<div class="playing-card ${extraClass}"><div class="card-back"></div></div>`;
            const color = (c.s === '♥' || c.s === '♦') ? 'card-red' : 'card-black';
            return `
            <div class="card-container ${extraClass}" id="${id}" ${onClickFn ? `onclick="${onClickFn}"` : ''}>
                <div class="playing-card flipped">
                    <div class="card-back"></div>
                    <div class="card-front ${color}">
                        <span class="text-xl leading-none">${c.v}</span>
                        <span class="text-4xl mt-1 leading-none">${c.s}</span>
                    </div>
                </div>
            </div>`;
        }
        function getHiddenCardHTML(id, onClickFn, extraClass='') {
            return `
            <div class="card-container ${extraClass}" id="${id}" ${onClickFn ? `onclick="${onClickFn}"` : ''}>
                <div class="playing-card">
                    <div class="card-back"></div>
                    <div class="card-front card-black">?</div>
                </div>
            </div>`;
        }

        // ================= ENGINE 1: HEXA-GUESS =================
        function renderHexa(game, me, opponent) {
            const canvas = document.getElementById('game-canvas');
            const prompt = document.getElementById('action-prompt');
            
            if (canvas.innerHTML.trim() === '') {
                // Initialize board
                let html = '<div class="flex flex-wrap justify-center gap-6 w-full max-w-lg">';
                for(let i=0; i<6; i++) {
                    html += getHiddenCardHTML(`hx-${i}`, `playMove('hide', ${i})`, `deal-in`);
                }
                html += '</div>';
                canvas.innerHTML = html;
            }

            // Phase logic
            if (me.data.hidden === undefined) {
                prompt.innerHTML = `<h3 class="text-indigo-400 font-bold text-lg mb-2">PHASE 1: HIDE A CARD</h3><p class="text-slate-400 text-sm">Select one card to keep secret from your opponent.</p>`;
                // Reset onclicks to hide
                for(let i=0; i<6; i++) document.getElementById(`hx-${i}`).setAttribute('onclick', `playMove('hide', ${i})`);
            } else if (me.data.guess === undefined) {
                prompt.innerHTML = `<h3 class="text-rose-400 font-bold text-lg mb-2">PHASE 2: GUESS THEIR CARD</h3><p class="text-slate-400 text-sm">Find where the opponent hid their card.</p>`;
                const myHidden = document.getElementById(`hx-${me.data.hidden} .playing-card`);
                if(myHidden) myHidden.classList.add('locked', 'flipped');
                if(myHidden) myHidden.querySelector('.card-front').innerHTML = '<span class="text-sm">YOURS</span>';
                
                // Set onclicks to guess
                for(let i=0; i<6; i++) document.getElementById(`hx-${i}`).setAttribute('onclick', `playMove('guess', ${i})`);
            } else {
                prompt.innerHTML = `<p class="text-slate-400 font-bold uppercase tracking-widest bg-black/40 px-6 py-2 rounded-full border border-white/5">Waiting for opponent...</p>`;
            }

            if (game.state === 'resolving' && opponent && opponent.data.hidden !== undefined) {
                const oppHidden = document.getElementById(`hx-${opponent.data.hidden} .playing-card`);
                oppHidden.classList.add('flipped');
                oppHidden.querySelector('.card-front').innerHTML = '<span class="text-sm text-rose-500">OPP</span>';
                
                const myGuess = document.getElementById(`hx-${me.data.guess} .playing-card`);
                myGuess.classList.add('flipped');
                myGuess.querySelector('.card-front').innerHTML = '<span class="text-sm">GUESS</span>';
            }
        }

        // ================= ENGINE 2: HIGH CARD =================
        function renderHighCard(game, me, opponent) {
            const canvas = document.getElementById('game-canvas');
            const prompt = document.getElementById('action-prompt');

            let p1Card = me.data.card ? getCardHTML(me.data.card, 'hc-me', null, 'pop-in') : getHiddenCardHTML('hc-me-hidden', null, 'locked');
            let p2Card = (opponent && opponent.data.card) ? (game.state === 'resolving' || game.state === 'finished' ? getCardHTML(opponent.data.card, 'hc-opp', null, 'pop-in') : getHiddenCardHTML('hc-opp-hidden', null, 'locked')) : getHiddenCardHTML('hc-opp-none', null, 'locked opacity-20');

            canvas.innerHTML = `
                <div class="w-full flex justify-around items-center gap-8">
                    <div class="text-center bg-black/40 p-6 rounded-3xl border border-indigo-500/20 w-48 shadow-lg">
                        <h3 class="text-indigo-400 font-bold mb-6 tracking-widest uppercase">YOU</h3>
                        <div class="flex justify-center h-[130px]">${p1Card}</div>
                    </div>
                    <div class="text-2xl font-black text-slate-600 italic">VS</div>
                    <div class="text-center bg-black/40 p-6 rounded-3xl border border-rose-500/20 w-48 shadow-lg">
                        <h3 class="text-rose-400 font-bold mb-6 tracking-widest uppercase">OPP</h3>
                        <div class="flex justify-center h-[130px]">${p2Card}</div>
                    </div>
                </div>
            `;

            if (!me.data.card) {
                prompt.innerHTML = `<button onclick="playMove('draw')" class="bg-indigo-600 hover:bg-indigo-500 text-white font-bold py-4 px-12 rounded-xl shadow-[0_0_20px_rgba(99,102,241,0.4)] transition-transform transform hover:-translate-y-1">DRAW CARD</button>`;
            } else {
                prompt.innerHTML = `<p class="text-slate-400 font-bold uppercase tracking-widest bg-black/40 px-6 py-2 rounded-full border border-white/5">Awaiting opponent draw...</p>`;
            }
        }

        // ================= ENGINE 3: TACTICAL WAR =================
        function renderWar(game, me, opponent) {
            const canvas = document.getElementById('game-canvas');
            const prompt = document.getElementById('action-prompt');

            // Render HUD
            let html = `
                <div class="w-full flex justify-between px-8 bg-black/40 py-4 rounded-2xl border border-white/5 mb-8">
                    <div class="text-center"><p class="text-[10px] text-slate-500 font-bold uppercase tracking-widest">ROUND</p><p class="text-2xl font-black text-white">${game.gameData.round}/3</p></div>
                    <div class="text-center"><p class="text-[10px] text-indigo-400 font-bold uppercase tracking-widest">YOUR WINS</p><p class="text-2xl font-black text-white">${game.players[0].id === me.id ? game.gameData.p1Wins : game.gameData.p2Wins}</p></div>
                    <div class="text-center"><p class="text-[10px] text-rose-400 font-bold uppercase tracking-widest">OPP WINS</p><p class="text-2xl font-black text-white">${game.players[0].id !== me.id ? game.gameData.p1Wins : game.gameData.p2Wins}</p></div>
                </div>
            `;

            // Render Combat Zone (Played Cards)
            let myPlayed = me.data.playedCard ? (game.state === 'resolving' ? getCardHTML(me.data.playedCard, 'w-my-p', null, 'pop-in') : getHiddenCardHTML('w-my-h', null, 'locked')) : getHiddenCardHTML('w-my-e', null, 'locked opacity-10');
            let oppPlayed = (opponent && opponent.data.playedCard) ? (game.state === 'resolving' ? getCardHTML(opponent.data.playedCard, 'w-op-p', null, 'pop-in') : getHiddenCardHTML('w-op-h', null, 'locked')) : getHiddenCardHTML('w-op-e', null, 'locked opacity-10');

            html += `
                <div class="flex justify-center gap-12 items-center mb-8">
                    <div class="flex flex-col items-center gap-2"><span class="text-xs font-bold text-indigo-400 uppercase tracking-widest">You Played</span>${myPlayed}</div>
                    <div class="flex flex-col items-center gap-2"><span class="text-xs font-bold text-rose-400 uppercase tracking-widest">Opp Played</span>${oppPlayed}</div>
                </div>
            `;

            // Render Hand
            if (me.data.hand) {
                html += `<div class="flex justify-center gap-4 mt-auto">`;
                me.data.hand.forEach((c, idx) => {
                    html += getCardHTML(c, `h-${idx}`, me.data.playedCard ? null : `playMove('play_card', ${idx})`, me.data.playedCard ? 'locked' : 'hover:-translate-y-4 deal-in');
                });
                html += `</div>`;
            }

            canvas.innerHTML = html;

            if (!me.data.playedCard) {
                prompt.innerHTML = `<p class="text-indigo-400 font-bold">Select a card from your hand to play this round.</p>`;
            } else {
                prompt.innerHTML = `<p class="text-slate-400 font-bold uppercase tracking-widest bg-black/40 px-6 py-2 rounded-full border border-white/5">Card locked. Waiting for opponent...</p>`;
            }
        }

        // Generic move emitter
        function playMove(action, payload = null) {
            socket.emit('play_move', { betId: currentBetId, action, payload });
        }
    </script>
</body>
</html>
