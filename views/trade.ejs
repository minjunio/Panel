<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Vault | PvP Arena</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="/socket.io/socket.io.js"></script>
    <style>
        ::-webkit-scrollbar { width: 6px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: #6366f1; border-radius: 10px; }
        
        body { background: radial-gradient(circle at top right, #1e1b4b 0%, #0B0F19 40%, #0B0F19 100%); }
        .glass-panel { background: rgba(15, 23, 42, 0.65); backdrop-filter: blur(20px); border: 1px solid rgba(255, 255, 255, 0.05); box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5); }
        
        /* Terminal Log Styling */
        .terminal-log { max-height: 350px; overflow-y: auto; scroll-behavior: smooth; font-family: monospace; }
        .terminal-log p { border-left: 2px solid #6366f1; padding-left: 10px; margin-bottom: 8px; opacity: 0; animation: fadeIn 0.3s forwards; background: rgba(0,0,0,0.2); padding-top: 4px; padding-bottom: 4px; border-radius: 0 4px 4px 0;}
        @keyframes fadeIn { to { opacity: 1; } }
        
        /* Responsive 3D Card Animations */
        .card-container { perspective: 1000px; margin: 4px; }
        
        /* Base Card sizing (Mobile First) */
        .playing-card { width: 65px; height: 95px; position: relative; transform-style: preserve-3d; transition: transform 0.5s cubic-bezier(0.4, 0.2, 0.2, 1); cursor: pointer; flex-shrink: 0; }
        
        /* Scale up for larger screens */
        @media (min-width: 640px) { .playing-card { width: 85px; height: 120px; } }
        
        .playing-card:hover:not(.locked) { transform: translateY(-8px) scale(1.05); box-shadow: 0 20px 30px rgba(99, 102, 241, 0.4); z-index: 20; }
        .card-front, .card-back { position: absolute; width: 100%; height: 100%; backface-visibility: hidden; border-radius: 8px; display: flex; flex-direction: column; align-items: center; justify-content: center; font-size: 20px; font-weight: 900; border: 2px solid rgba(255,255,255,0.15); box-shadow: -2px 4px 10px rgba(0,0,0,0.4); }
        @media (min-width: 640px) { .card-front, .card-back { font-size: 26px; border-radius: 12px; } }
        
        .card-back { background: repeating-linear-gradient(45deg, #1e1b4b, #1e1b4b 10px, #312e81 10px, #312e81 20px); }
        .card-front { background: #ffffff; transform: rotateY(180deg); }
        .card-red { color: #ef4444; } .card-black { color: #0f172a; }
        .flipped { transform: rotateY(180deg); }
        .locked { opacity: 0.5; pointer-events: none; }
        
        /* Entrance & State Animations */
        .deal-in { animation: deal 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards; opacity: 0; transform: translateY(-40px) scale(0.5) rotate(-5deg); }
        @keyframes deal { to { opacity: 1; transform: translateY(0) scale(1) rotate(0deg); } }
        
        .pop-in { animation: pop 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards; }
        @keyframes pop { 0% { transform: scale(0.8); opacity: 0; } 100% { transform: scale(1); opacity: 1; } }
    </style>
</head>
<body class="text-slate-200 font-sans antialiased min-h-screen p-3 md:p-6 lg:p-8">

    <div class="max-w-7xl mx-auto space-y-6">
        
        <header class="flex justify-between items-center glass-panel rounded-full px-5 py-3 border-b border-white/10">
            <h1 class="text-lg md:text-xl font-black text-white tracking-widest flex items-center gap-2 md:gap-3 drop-shadow-md">
                <span class="p-2 md:p-2.5 bg-gradient-to-br from-indigo-500 to-violet-600 rounded-full text-white shadow-lg shadow-indigo-500/30 text-sm md:text-base leading-none">⚔️</span> 
                <span class="hidden sm:inline">PVP ARENA</span><span class="sm:hidden">ARENA</span>
            </h1>
            <a href="/wallet/portfolio" class="text-xs md:text-sm font-bold text-slate-300 hover:text-white bg-white/5 hover:bg-white/10 px-4 md:px-6 py-2.5 rounded-full transition-all border border-white/10 shadow-inner">Return to Vault</a>
        </header>

        <% if (error) { %>
            <div class="bg-red-500/10 border border-red-500/40 text-red-400 p-4 rounded-2xl flex items-center gap-3 animate-pulse shadow-lg shadow-red-500/10">
                <p class="font-bold tracking-wide text-sm">⚠️ <%= error %></p>
            </div>
        <% } %>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6" id="lobby-view">
            
            <div class="lg:col-span-5 xl:col-span-4 glass-panel rounded-[2rem] p-6 sm:p-8 relative overflow-hidden">
                <div class="absolute -top-32 -left-32 w-64 h-64 bg-indigo-600/20 rounded-full blur-[80px] pointer-events-none"></div>
                
                <h2 class="text-white text-2xl font-black mb-8 flex items-center gap-2 relative z-10">Host Match</h2>
                <form action="/trade/host" method="POST" class="space-y-6 relative z-10">
                    
                    <div class="grid grid-cols-2 gap-3 bg-black/50 p-2 rounded-2xl border border-white/5 shadow-inner">
                        <label class="cursor-pointer text-center">
                            <input type="radio" name="chain" value="ETH" class="peer sr-only" onchange="updateBalanceUI()" checked>
                            <div class="py-2.5 rounded-xl text-sm font-bold text-slate-500 peer-checked:bg-indigo-500/20 peer-checked:text-indigo-300 peer-checked:border peer-checked:border-indigo-500/30 transition-all">Ethereum</div>
                        </label>
                        <label class="cursor-pointer text-center">
                            <input type="radio" name="chain" value="SOL" class="peer sr-only" onchange="updateBalanceUI()">
                            <div class="py-2.5 rounded-xl text-sm font-bold text-slate-500 peer-checked:bg-emerald-500/20 peer-checked:text-emerald-300 peer-checked:border peer-checked:border-emerald-500/30 transition-all">Solana</div>
                        </label>
                    </div>

                    <div>
                        <label class="block text-[10px] sm:text-xs font-bold text-slate-400 mb-2 uppercase tracking-widest">Combat Engine</label>
                        <select name="game" class="w-full bg-black/50 border border-white/10 rounded-2xl p-4 text-white text-sm sm:text-base font-bold outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 transition-all cursor-pointer">
                            <option value="hexa">🎴 Hexa-Guess (Memory/Bluff)</option>
                            <option value="highcard">🃏 High Card (Sudden Death)</option>
                            <option value="war">⚔️ Tactical War (Best of 3)</option>
                        </select>
                    </div>

                    <div class="bg-black/30 p-4 rounded-2xl border border-white/5">
                        <div class="flex justify-between items-end mb-3">
                            <label class="block text-[10px] sm:text-xs font-bold text-slate-400 uppercase tracking-widest">Wager</label>
                            <span class="text-[10px] text-indigo-400 font-mono font-bold bg-indigo-500/10 px-2 py-1 rounded border border-indigo-500/20">Avail: <span id="display-bal">0.00</span></span>
                        </div>
                        <input type="number" id="stake-amt" name="amount" step="any" placeholder="0.000" class="w-full bg-black/60 border border-white/10 rounded-xl p-3 sm:p-4 text-white text-lg sm:text-xl font-black outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 transition-all mb-4 text-center">
                        <div class="grid grid-cols-3 gap-2">
                            <button type="button" onclick="setFraction(0.25)" class="bg-white/5 hover:bg-white/10 py-2.5 rounded-xl text-xs font-bold text-slate-300 transition-all">25%</button>
                            <button type="button" onclick="setFraction(0.50)" class="bg-white/5 hover:bg-white/10 py-2.5 rounded-xl text-xs font-bold text-slate-300 transition-all">50%</button>
                            <button type="button" onclick="setFraction(1.0)" class="bg-indigo-500/20 hover:bg-indigo-500/40 border border-indigo-500/30 text-indigo-300 py-2.5 rounded-xl text-xs font-black transition-all">MAX</button>
                        </div>
                    </div>

                    <div class="space-y-3">
                        <label class="flex items-center gap-4 p-4 bg-black/40 rounded-2xl border border-white/5 cursor-pointer hover:bg-black/60 transition-colors">
                            <input type="checkbox" name="isPrivate" class="w-5 h-5 accent-indigo-500 rounded bg-black">
                            <span class="text-sm font-bold text-white tracking-wide">Private Room <span class="text-[10px] sm:text-xs text-slate-400 font-normal block">Generates Access Code</span></span>
                        </label>
                        <label class="flex items-center gap-4 p-4 bg-emerald-950/20 rounded-2xl border border-emerald-500/20 cursor-pointer hover:bg-emerald-950/40 transition-colors">
                            <input type="checkbox" name="isPractice" class="w-5 h-5 accent-emerald-500 rounded bg-black">
                            <span class="text-sm font-bold text-emerald-400 tracking-wide">Practice Mode <span class="text-[10px] sm:text-xs text-emerald-600 font-normal block">Free PVP. Zero Capital Risk.</span></span>
                        </label>
                    </div>

                    <button type="submit" class="w-full bg-gradient-to-r from-indigo-600 to-violet-600 hover:from-indigo-500 hover:to-violet-500 text-white font-black text-sm sm:text-lg py-4 sm:py-5 rounded-2xl shadow-[0_10px_30px_-10px_rgba(99,102,241,0.6)] transition-all transform hover:scale-[1.02] border border-indigo-400/30 tracking-widest uppercase">
                        Initialize Matrix
                    </button>
                </form>
            </div>

            <div class="lg:col-span-7 xl:col-span-8 flex flex-col gap-6">
                
                <div class="glass-panel rounded-[2rem] p-6 sm:p-8 relative overflow-hidden">
                    <div class="absolute inset-0 bg-[url('data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iMjAiIGhlaWdodD0iMjAiIHhtbG5zPSJodHRwOi8vd3d3LnczLm9yZy8yMDAwL3N2ZyI+PGNpcmNsZSBjeD0iMSIgY3k9IjEiIHI9IjEiIGZpbGw9InJnYmEoMjU1LDI1NSwyNTUsMC4wNSkiLz48L3N2Zz4=')] opacity-50 pointer-events-none"></div>
                    <form action="/trade/join" method="POST" class="flex flex-col sm:flex-row gap-4 relative z-10">
                        <input type="text" name="accessKey" required placeholder="ENTER PRIVATE CODE..." class="flex-1 bg-black/60 border border-indigo-500/30 rounded-2xl p-4 sm:p-5 text-indigo-300 font-mono text-sm sm:text-base focus:border-indigo-400 outline-none uppercase tracking-widest text-center sm:text-left shadow-inner">
                        <button type="submit" class="bg-indigo-600 hover:bg-indigo-500 text-white font-black px-8 py-4 sm:py-5 rounded-2xl transition-all shadow-lg active:scale-95 whitespace-nowrap text-sm sm:text-base">JOIN TARGET</button>
                    </form>
                </div>

                <div class="glass-panel rounded-[2rem] p-6 sm:p-8 flex-1">
                    <h2 class="text-white text-xl sm:text-2xl font-black mb-6 flex items-center justify-between sm:justify-start gap-4 border-b border-white/5 pb-4">
                        GLOBAL LOBBIES 
                        <span class="flex items-center gap-2 text-[10px] sm:text-xs bg-emerald-500/20 text-emerald-400 px-3 py-1.5 rounded-full border border-emerald-500/30">
                            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span> LIVE
                        </span>
                    </h2>
                    
                    <% if (publicBets && publicBets.length > 0) { %>
                        <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4">
                            <% publicBets.forEach(bet => { %>
                                <div class="bg-black/40 border border-white/5 hover:border-indigo-500/50 rounded-[1.5rem] p-5 transition-all group relative overflow-hidden flex flex-col justify-between min-h-[180px]">
                                    <div class="absolute -bottom-4 -right-2 opacity-5 group-hover:opacity-10 transition-opacity">
                                        <span class="text-8xl font-black"><%= bet.hostChain === 'SOL' ? '◎' : 'Ξ' %></span>
                                    </div>
                                    
                                    <div class="relative z-10 flex justify-between items-start mb-4">
                                        <div class="space-y-1.5 w-full">
                                            <span class="px-2 py-1 rounded-md text-[9px] font-black tracking-widest uppercase <%= bet.isPractice ? 'bg-emerald-500/20 text-emerald-400 border border-emerald-500/30' : 'bg-indigo-500/20 text-indigo-400 border border-indigo-500/30' %> inline-block">
                                                <%= bet.isPractice ? 'PRACTICE' : bet.hostChain + ' MATCH' %>
                                            </span>
                                            <h3 class="text-white font-black text-lg sm:text-xl capitalize truncate"><%= bet.game %></h3>
                                        </div>
                                    </div>

                                    <div class="relative z-10 bg-black/60 px-4 py-2.5 rounded-xl border border-white/5 shadow-inner mb-4 flex justify-between items-center">
                                        <p class="text-[10px] text-slate-500 font-bold tracking-widest uppercase">STAKE</p>
                                        <div class="text-right">
                                            <span class="text-lg font-black text-white leading-none"><%= bet.cryptoAmount %></span>
                                            <span class="text-[10px] text-slate-400 font-bold ml-1"><%= bet.hostChain %></span>
                                        </div>
                                    </div>

                                    <form action="/trade/join" method="POST" class="relative z-10 mt-auto">
                                        <input type="hidden" name="betId" value="<%= bet.id %>">
                                        <button type="submit" class="w-full bg-white/5 group-hover:bg-indigo-600 text-white font-bold py-3 rounded-xl transition-all border border-white/10 group-hover:border-indigo-400 shadow-sm text-sm">CHALLENGE</button>
                                    </form>
                                </div>
                            <% }) %>
                        </div>
                    <% } else { %>
                        <div class="flex flex-col items-center justify-center py-16 text-slate-500 bg-black/20 rounded-3xl border border-dashed border-white/10 text-center px-4">
                            <svg class="w-12 h-12 mb-3 opacity-40" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 002-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path></svg>
                            <p class="text-lg font-bold text-slate-400">No open lobbies.</p>
                            <p class="text-xs mt-1">Host a match to populate the network.</p>
                        </div>
                    <% } %>
                </div>
            </div>
        </div>

        <div id="live-board" class="hidden grid grid-cols-1 lg:grid-cols-12 gap-6">
            
            <div class="lg:col-span-8 xl:col-span-9 glass-panel rounded-[2rem] p-4 sm:p-8 min-h-[500px] sm:min-h-[600px] flex flex-col justify-between relative overflow-hidden">
                <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,_var(--tw-gradient-stops))] from-indigo-900/15 via-transparent to-transparent pointer-events-none"></div>
                
                <div class="text-center z-20 flex flex-col items-center mb-6">
                    <h2 id="game-title" class="text-2xl sm:text-4xl font-black text-white uppercase tracking-widest drop-shadow-lg mb-2">ARENA</h2>
                    <p id="game-status" class="text-indigo-300 text-xs sm:text-sm font-bold bg-black/60 px-5 py-1.5 rounded-full border border-indigo-500/30 shadow-lg tracking-wide">Connecting to node...</p>
                    
                    <div id="room-code-container" class="mt-4 hidden w-full max-w-sm">
                        </div>
                </div>

                <div id="game-canvas" class="flex-1 flex flex-col items-center justify-center gap-6 z-10 w-full max-w-full overflow-hidden">
                    </div>

                <div class="mt-6 text-center z-20 min-h-[80px] bg-black/40 p-4 rounded-2xl border border-white/5 backdrop-blur-md flex flex-col justify-center items-center" id="action-prompt">
                    </div>
            </div>

            <div class="lg:col-span-4 xl:col-span-3 glass-panel rounded-[2rem] p-5 sm:p-6 flex flex-col h-full max-h-[400px] lg:max-h-[600px]">
                <h3 class="text-white font-black mb-4 uppercase text-[10px] sm:text-xs tracking-widest border-b border-white/10 pb-3 flex items-center gap-2">
                    <span class="w-2 h-2 rounded-full bg-emerald-500 shadow-[0_0_10px_rgba(16,185,129,0.8)] animate-pulse"></span> NETWORK LOGS
                </h3>
                <div id="log-container" class="terminal-log flex-1 bg-black/60 rounded-xl p-3 sm:p-4 border border-indigo-500/20 shadow-inner text-[10px] sm:text-xs">
                    </div>
            </div>
        </div>
    </div>

    <script>
        // Copy to Clipboard Utility
        function copyCode(code, btnElement) {
            navigator.clipboard.writeText(code).then(() => {
                const originalText = btnElement.innerHTML;
                btnElement.innerHTML = "✅";
                btnElement.classList.replace('bg-indigo-600', 'bg-emerald-600');
                setTimeout(() => {
                    btnElement.innerHTML = originalText;
                    btnElement.classList.replace('bg-emerald-600', 'bg-indigo-600');
                }, 2000);
            });
        }

        // Fractional Wallet Logic
        const myEthAddress = "<%= wallet.ethAddress %>";
        const mySolAddress = "<%= wallet.solAddress %>";
        const balances = { ETH: <%= wallet.balances ? wallet.balances.eth : 0 %>, SOL: <%= wallet.balances ? wallet.balances.sol : 0 %> };

        function updateBalanceUI() {
            const chain = document.querySelector('input[name="chain"]:checked').value;
            document.getElementById('display-bal').innerText = balances[chain].toFixed(4) + ' ' + chain;
            document.getElementById('stake-amt').value = ''; 
        }
        // Initialize
        updateBalanceUI();

        function setFraction(perc) {
            const chain = document.querySelector('input[name="chain"]:checked').value;
            document.getElementById('stake-amt').value = (balances[chain] * perc).toFixed(4);
        }

        // ================= SOCKET.IO CORE =================
        const socket = io();
        let currentBetId = null;

        const urlParams = new URLSearchParams(window.location.search);
        if (urlParams.get('join')) joinGame(urlParams.get('join'));

        function joinGame(betId) {
            currentBetId = betId;
            document.getElementById('lobby-view').classList.add('hidden');
            document.getElementById('live-board').classList.remove('hidden');
            socket.emit('join_game', betId);
        }

        socket.on('game_error', (msg) => { alert(msg); window.location.href = '/wallet/trade'; });

        // Master State Router
        socket.on('update_state', (game) => {
            const myId = game.hostChain === 'SOL' ? mySolAddress : myEthAddress;
            const me = game.players.find(p => p.id === myId);
            const opponent = game.players.find(p => p.id !== myId);

            // Print Logs
            const logBox = document.getElementById('log-container');
            logBox.innerHTML = game.logs.map(l => `<p class="text-emerald-400 font-bold tracking-wide break-words">${l}</p>`).join('');
            logBox.scrollTop = logBox.scrollHeight;

            // Status Management
            const status = document.getElementById('game-status');
            document.getElementById('game-title').innerText = `${game.game.toUpperCase()} PROTOCOL`;
            
            if (game.state === 'waiting') {
                status.innerText = "WAITING FOR CHALLENGER...";
                status.classList.add('animate-pulse');
            } else if (game.state === 'resolving') {
                status.innerText = "RESOLVING COMBAT...";
                status.classList.remove('animate-pulse');
            } else if (game.state === 'finished') {
                status.innerText = game.winner === myId ? "VICTORY ACHIEVED" : (game.winner ? "DEFEAT" : "DRAW");
                status.classList.remove('animate-pulse');
            } else {
                status.innerText = "ACTIVE COMBAT PHASE";
                status.classList.remove('animate-pulse');
            }

            // Private Code Box Generator
            const roomCodeContainer = document.getElementById('room-code-container');
            if (game.state === 'waiting' && game.isPrivate && game.accessKey) {
                roomCodeContainer.classList.remove('hidden');
                roomCodeContainer.innerHTML = `
                    <div class="inline-flex flex-col items-center bg-black/60 border border-indigo-500/50 rounded-2xl p-4 shadow-[0_0_20px_rgba(99,102,241,0.2)] w-full">
                        <span class="text-[9px] sm:text-[10px] text-indigo-400 font-bold uppercase tracking-widest mb-2">Share this code to invite opponent</span>
                        <div class="flex items-center justify-center gap-2 sm:gap-4 w-full">
                            <code class="text-xl sm:text-2xl font-mono text-white font-black tracking-widest drop-shadow-md bg-black/50 px-3 py-1 sm:py-2 rounded-xl border border-white/10">${game.accessKey}</code>
                            <button onclick="copyCode('${game.accessKey}', this)" class="bg-indigo-600 hover:bg-indigo-500 text-white font-bold px-3 py-1.5 sm:px-4 sm:py-2.5 rounded-xl transition-all shadow-lg active:scale-95 text-xs sm:text-sm">
                                COPY
                            </button>
                        </div>
                    </div>
                `;
            } else {
                roomCodeContainer.classList.add('hidden');
            }

            if (!me) return;

            // Engine Render Dispatcher
            if (game.game === 'hexa') renderHexa(game, me, opponent);
            if (game.game === 'highcard') renderHighCard(game, me, opponent);
            if (game.game === 'war') renderWar(game, me, opponent);
        });

        // HTML Card Generators
        function getCardHTML(c, id, onClickFn, extraClass='') {
            if (!c) return `<div class="playing-card ${extraClass}"><div class="card-back"></div></div>`;
            const color = (c.s === '♥' || c.s === '♦') ? 'card-red' : 'card-black';
            return `
            <div class="card-container ${extraClass}" id="${id}" ${onClickFn ? `onclick="${onClickFn}"` : ''}>
                <div class="playing-card flipped">
                    <div class="card-back"></div>
                    <div class="card-front ${color}">
                        <span class="text-lg sm:text-2xl leading-none">${c.v}</span>
                        <span class="text-3xl sm:text-5xl mt-1 sm:mt-2 leading-none">${c.s}</span>
                    </div>
                </div>
            </div>`;
        }
        function getHiddenCardHTML(id, onClickFn, extraClass='') {
            return `
            <div class="card-container ${extraClass}" id="${id}" ${onClickFn ? `onclick="${onClickFn}"` : ''}>
                <div class="playing-card">
                    <div class="card-back"></div>
                    <div class="card-front card-black font-black text-2xl sm:text-4xl text-slate-800">?</div>
                </div>
            </div>`;
        }

        // Emit Move Wrapper
        function playMove(action, payload = null) {
            socket.emit('play_move', { betId: currentBetId, action, payload });
        }

        // ================= ENGINE 1: HEXA-GUESS =================
        function renderHexa(game, me, opponent) {
            const canvas = document.getElementById('game-canvas');
            const prompt = document.getElementById('action-prompt');
            
            // Layout: Using flex-wrap to ensure they stack neatly on mobile
            if (canvas.innerHTML.trim() === '') {
                let html = '<div class="flex flex-wrap justify-center items-center gap-2 sm:gap-4 w-full max-w-md mx-auto">';
                for(let i=0; i<6; i++) html += getHiddenCardHTML(`hx-${i}`, `playMove('hide', ${i})`, `deal-in`);
                html += '</div>';
                canvas.innerHTML = html;
            }

            if (me.data.hidden === undefined) {
                prompt.innerHTML = `<h3 class="text-indigo-400 font-black text-sm sm:text-lg mb-1 tracking-widest">PHASE 1: HIDE A CARD</h3><p class="text-slate-400 text-[10px] sm:text-xs font-bold">Select one card to keep secret.</p>`;
                for(let i=0; i<6; i++) document.getElementById(`hx-${i}`).setAttribute('onclick', `playMove('hide', ${i})`);
            } else if (me.data.guess === undefined) {
                prompt.innerHTML = `<h3 class="text-rose-400 font-black text-sm sm:text-lg mb-1 tracking-widest">PHASE 2: GUESS TARGET</h3><p class="text-slate-400 text-[10px] sm:text-xs font-bold">Find where they hid their card.</p>`;
                const myHidden = document.getElementById(`hx-${me.data.hidden} .playing-card`);
                if(myHidden) {
                    myHidden.classList.add('locked', 'flipped');
                    myHidden.querySelector('.card-front').innerHTML = '<span class="text-[10px] sm:text-sm font-black tracking-widest text-indigo-600">YOURS</span>';
                }
                for(let i=0; i<6; i++) document.getElementById(`hx-${i}`).setAttribute('onclick', `playMove('guess', ${i})`);
            } else {
                prompt.innerHTML = `<p class="text-slate-400 font-bold text-xs uppercase tracking-widest bg-black/40 px-4 py-2 rounded-full border border-white/5">Waiting for opponent...</p>`;
            }

            if (game.state === 'resolving' && opponent && opponent.data.hidden !== undefined) {
                const oppHidden = document.getElementById(`hx-${opponent.data.hidden} .playing-card`);
                oppHidden.classList.add('flipped');
                oppHidden.querySelector('.card-front').innerHTML = '<span class="text-[10px] sm:text-sm font-black tracking-widest text-rose-500">OPP</span>';
                
                const myGuess = document.getElementById(`hx-${me.data.guess} .playing-card`);
                myGuess.classList.add('flipped');
                myGuess.querySelector('.card-front').innerHTML = '<span class="text-[8px] sm:text-[10px] font-black tracking-widest text-slate-800">GUESS</span>';
            }
        }

        // ================= ENGINE 2: HIGH CARD =================
        function renderHighCard(game, me, opponent) {
            const canvas = document.getElementById('game-canvas');
            const prompt = document.getElementById('action-prompt');

            let p1Card = me.data.card ? getCardHTML(me.data.card, 'hc-me', null, 'pop-in') : getHiddenCardHTML('hc-me-hidden', null, 'locked');
            let p2Card = (opponent && opponent.data.card) ? (game.state === 'resolving' || game.state === 'finished' ? getCardHTML(opponent.data.card, 'hc-opp', null, 'pop-in') : getHiddenCardHTML('hc-opp-hidden', null, 'locked')) : getHiddenCardHTML('hc-opp-none', null, 'locked opacity-20 border-dashed');

            // Responsive flex row with wrap-around fallback
            canvas.innerHTML = `
                <div class="w-full flex flex-row flex-wrap justify-center sm:justify-around items-center gap-4 sm:gap-6 px-4">
                    <div class="text-center bg-black/50 p-4 sm:p-6 rounded-[2rem] border border-indigo-500/20 shadow-lg relative flex-1 min-w-[120px] max-w-[200px]">
                        <h3 class="text-indigo-400 font-black mb-3 sm:mb-5 tracking-widest uppercase text-[10px] sm:text-xs bg-black px-3 py-1 rounded-full absolute -top-3 left-1/2 -translate-x-1/2 border border-indigo-500/30">YOU</h3>
                        <div class="flex justify-center min-h-[100px] sm:min-h-[140px] items-center mt-2">${p1Card}</div>
                    </div>
                    <div class="text-xl sm:text-3xl font-black text-slate-600 italic bg-black/40 px-3 py-1 sm:px-4 sm:py-2 rounded-full border border-white/5 mx-2">VS</div>
                    <div class="text-center bg-black/50 p-4 sm:p-6 rounded-[2rem] border border-rose-500/20 shadow-lg relative flex-1 min-w-[120px] max-w-[200px]">
                        <h3 class="text-rose-400 font-black mb-3 sm:mb-5 tracking-widest uppercase text-[10px] sm:text-xs bg-black px-3 py-1 rounded-full absolute -top-3 left-1/2 -translate-x-1/2 border border-rose-500/30">OPP</h3>
                        <div class="flex justify-center min-h-[100px] sm:min-h-[140px] items-center mt-2">${p2Card}</div>
                    </div>
                </div>
            `;

            if (!me.data.card) {
                prompt.innerHTML = `<button onclick="playMove('draw')" class="bg-indigo-600 hover:bg-indigo-500 text-white font-black text-sm sm:text-base py-3 sm:py-4 px-10 sm:px-16 rounded-xl shadow-[0_10px_20px_-10px_rgba(99,102,241,0.6)] transition-all transform hover:-translate-y-1 border border-indigo-400/30 tracking-widest">DRAW CARD</button>`;
            } else {
                prompt.innerHTML = `<p class="text-slate-400 font-bold text-xs uppercase tracking-widest">Awaiting opponent...</p>`;
            }
        }

        // ================= ENGINE 3: TACTICAL WAR =================
        function renderWar(game, me, opponent) {
            const canvas = document.getElementById('game-canvas');
            const prompt = document.getElementById('action-prompt');

            let html = `
                <div class="w-full max-w-md flex justify-between px-4 sm:px-8 bg-black/60 py-3 sm:py-4 rounded-2xl sm:rounded-3xl border border-indigo-500/20 shadow-inner mb-4 sm:mb-6">
                    <div class="text-center"><p class="text-[8px] sm:text-[10px] text-slate-400 font-black uppercase tracking-widest mb-1">ROUND</p><p class="text-xl sm:text-3xl font-black text-white leading-none">${game.gameData.round}/3</p></div>
                    <div class="text-center"><p class="text-[8px] sm:text-[10px] text-indigo-400 font-black uppercase tracking-widest mb-1">YOUR WINS</p><p class="text-xl sm:text-3xl font-black text-indigo-300 leading-none">${game.players[0].id === me.id ? game.gameData.p1Wins : game.gameData.p2Wins}</p></div>
                    <div class="text-center"><p class="text-[8px] sm:text-[10px] text-rose-400 font-black uppercase tracking-widest mb-1">OPP WINS</p><p class="text-xl sm:text-3xl font-black text-rose-300 leading-none">${game.players[0].id !== me.id ? game.gameData.p1Wins : game.gameData.p2Wins}</p></div>
                </div>
            `;

            let myPlayed = me.data.playedCard ? (game.state === 'resolving' ? getCardHTML(me.data.playedCard, 'w-my-p', null, 'pop-in') : getHiddenCardHTML('w-my-h', null, 'locked')) : getHiddenCardHTML('w-my-e', null, 'locked opacity-10 border-dashed');
            let oppPlayed = (opponent && opponent.data.playedCard) ? (game.state === 'resolving' ? getCardHTML(opponent.data.playedCard, 'w-op-p', null, 'pop-in') : getHiddenCardHTML('w-op-h', null, 'locked')) : getHiddenCardHTML('w-op-e', null, 'locked opacity-10 border-dashed');

            html += `
                <div class="flex justify-center gap-6 sm:gap-12 items-center mb-6 w-full max-w-sm sm:max-w-md bg-black/30 p-4 sm:p-8 rounded-[2rem] sm:rounded-[3rem] border border-white/5">
                    <div class="flex flex-col items-center gap-3"><span class="text-[10px] sm:text-xs font-black text-indigo-400 uppercase tracking-widest bg-black px-3 py-1 rounded-full border border-indigo-500/30">You</span>${myPlayed}</div>
                    <div class="flex flex-col items-center gap-3"><span class="text-[10px] sm:text-xs font-black text-rose-400 uppercase tracking-widest bg-black px-3 py-1 rounded-full border border-rose-500/30">Opp</span>${oppPlayed}</div>
                </div>
            `;

            if (me.data.hand) {
                // Ensure hand wraps safely on tiny screens
                html += `<div class="flex flex-wrap justify-center gap-2 sm:gap-4 mt-auto w-full px-2">`;
                me.data.hand.forEach((c, idx) => {
                    html += getCardHTML(c, `h-${idx}`, me.data.playedCard ? null : `playMove('play_card', ${idx})`, me.data.playedCard ? 'locked' : 'hover:-translate-y-4 deal-in');
                });
                html += `</div>`;
            }

            canvas.innerHTML = html;

            if (!me.data.playedCard) {
                prompt.innerHTML = `<p class="text-indigo-400 font-black tracking-widest text-xs sm:text-sm">Select a card to deploy</p>`;
            } else {
                prompt.innerHTML = `<p class="text-slate-400 font-bold uppercase tracking-widest text-xs">Waiting for opponent...</p>`;
            }
        }
    </script>
</body>
</html>
