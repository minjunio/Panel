<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Vault | Arena</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        ::-webkit-scrollbar { width: 6px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: #334155; border-radius: 10px; }
        .glass-panel { background: rgba(30, 41, 59, 0.4); backdrop-filter: blur(12px); border: 1px solid rgba(255, 255, 255, 0.05); }
        .glow-active { box-shadow: 0 0 20px rgba(139, 92, 246, 0.4); }
    </style>
    <script>
        // Toggles between Live Stakes and Practice Mode UI
        function setMode(mode) {
            const isLive = mode === 'live';
            document.getElementById('btn-live').className = isLive ? 'flex-1 py-2 rounded-full text-sm font-semibold bg-violet-500 text-white shadow-md transition-all' : 'flex-1 py-2 rounded-full text-sm font-semibold text-slate-400 hover:text-white transition-all';
            document.getElementById('btn-practice').className = !isLive ? 'flex-1 py-2 rounded-full text-sm font-semibold bg-emerald-500 text-white shadow-md transition-all' : 'flex-1 py-2 rounded-full text-sm font-semibold text-slate-400 hover:text-white transition-all';
            
            document.getElementById('live-content').classList.toggle('hidden', !isLive);
            document.getElementById('practice-content').classList.toggle('hidden', isLive);
        }

        function handlePracticeSubmit(e) {
            e.preventDefault();
            const btn = e.submitter;
            const originalText = btn.innerHTML;
            btn.innerHTML = 'Simulating...';
            btn.classList.add('opacity-50');
            setTimeout(() => {
                alert("Practice Match Resolved! Result: You Won (Simulated)");
                btn.innerHTML = originalText;
                btn.classList.remove('opacity-50');
            }, 1000);
        }
    </script>
</head>
<body class="bg-[#0B0F19] text-slate-200 font-sans antialiased min-h-screen selection:bg-violet-500/30 selection:text-white p-4 md:p-8">

    <div class="max-w-6xl mx-auto space-y-6">
        
        <!-- Header -->
        <header class="flex flex-col sm:flex-row justify-between items-center glass-panel rounded-full px-6 py-4 shadow-lg gap-4">
            <div class="flex items-center space-x-3">
                <div class="w-8 h-8 rounded-full bg-gradient-to-tr from-violet-500 to-fuchsia-500 flex items-center justify-center shadow-lg shadow-violet-500/30">
                    <svg class="w-4 h-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                </div>
                <h1 class="text-lg font-bold text-white tracking-wide">Arena Dashboard</h1>
            </div>
            
            <!-- Global Mode Switcher -->
            <div class="flex bg-black/40 p-1 rounded-full border border-white/5 w-64">
                <button id="btn-live" onclick="setMode('live')" class="flex-1 py-2 rounded-full text-sm font-semibold bg-violet-500 text-white shadow-md transition-all">Live Stakes</button>
                <button id="btn-practice" onclick="setMode('practice')" class="flex-1 py-2 rounded-full text-sm font-semibold text-slate-400 hover:text-white transition-all">Practice</button>
            </div>

            <a href="/wallet/portfolio" class="text-xs font-semibold text-slate-400 hover:text-white bg-slate-800/50 hover:bg-slate-700/50 px-4 py-2 rounded-full transition-all">
                Close Arena
            </a>
        </header>

        <!-- System Alerts -->
        <% if (error) { %>
            <div class="bg-red-500/10 border border-red-500/20 text-red-400 p-4 rounded-2xl flex items-center gap-3 backdrop-blur-md">
                <svg class="w-5 h-5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                <p class="text-sm font-medium"><%= error %></p>
            </div>
        <% } %>
        <% if (success) { %>
            <div class="bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 p-4 rounded-2xl flex items-center gap-3 backdrop-blur-md">
                <svg class="w-5 h-5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                <p class="text-sm font-medium"><%= success %></p>
            </div>
        <% } %>

        <!-- ================= LIVE STAKES CONTENT ================= -->
        <div id="live-content" class="grid grid-cols-1 lg:grid-cols-12 gap-6">
            
            <!-- Create Game Panel -->
            <div class="lg:col-span-4 space-y-6">
                <div class="glass-panel rounded-[2rem] p-6 relative overflow-hidden">
                    <div class="absolute top-0 right-0 w-32 h-32 bg-violet-500/20 rounded-full blur-3xl -translate-y-1/2 translate-x-1/2"></div>
                    
                    <h2 class="text-white text-lg font-bold mb-6 flex items-center gap-2">
                        <svg class="w-5 h-5 text-violet-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path></svg>
                        Create Game
                    </h2>
                    
                    <form action="/trade/host" method="POST" class="space-y-5 relative z-10">
                        <div>
                            <label class="block text-xs font-semibold text-slate-400 mb-2 uppercase tracking-wide">Network Asset</label>
                            <div class="grid grid-cols-2 gap-3">
                                <label class="cursor-pointer">
                                    <input type="radio" name="chain" value="ETH" class="peer sr-only" checked>
                                    <div class="p-3 rounded-xl border border-white/5 bg-black/20 text-center text-sm font-medium text-slate-400 peer-checked:border-violet-500 peer-checked:bg-violet-500/10 peer-checked:text-violet-300 transition-all">Ethereum</div>
                                </label>
                                <label class="cursor-pointer">
                                    <input type="radio" name="chain" value="SOL" class="peer sr-only">
                                    <div class="p-3 rounded-xl border border-white/5 bg-black/20 text-center text-sm font-medium text-slate-400 peer-checked:border-emerald-500 peer-checked:bg-emerald-500/10 peer-checked:text-emerald-300 transition-all">Solana</div>
                                </label>
                            </div>
                        </div>

                        <div>
                            <label class="block text-xs font-semibold text-slate-400 mb-2 uppercase tracking-wide">Select Mode</label>
                            <select name="game" class="w-full bg-black/30 border border-white/10 rounded-xl p-3 text-white text-sm focus:border-violet-500 outline-none appearance-none cursor-pointer">
                                <option value="coinflip">🎲 Coinflip (50/50)</option>
                                <option value="dice">🎯 Dice Roll (Higher Wins)</option>
                                <option value="blackjack">🃏 Blackjack (Auto-deal)</option>
                            </select>
                        </div>

                        <div>
                            <label class="block text-xs font-semibold text-slate-400 mb-2 uppercase tracking-wide">Stake Value ($USD)</label>
                            <input type="number" name="amountUSD" step="1" min="1" required placeholder="0.00" class="w-full bg-black/30 border border-white/10 rounded-xl p-4 text-white text-lg focus:border-violet-500 outline-none transition-all">
                        </div>

                        <label class="flex items-center gap-3 p-3 bg-black/20 rounded-xl border border-white/5 cursor-pointer hover:bg-black/40 transition-colors">
                            <input type="checkbox" name="isPrivate" class="w-4 h-4 rounded border-slate-700 text-violet-500 focus:ring-violet-500 bg-slate-900">
                            <span class="text-sm text-slate-300 font-medium">Make Private (Requires Key)</span>
                        </label>

                        <button type="submit" class="w-full bg-gradient-to-r from-violet-600 to-indigo-600 hover:from-violet-500 hover:to-indigo-500 text-white font-bold py-4 rounded-xl shadow-lg shadow-violet-500/25 transition-transform transform hover:scale-[1.02]">
                            Host Match
                        </button>
                    </form>
                </div>
            </div>

            <!-- Global Order Book & Private Join -->
            <div class="lg:col-span-8 space-y-6">
                
                <!-- Open Lobbies -->
                <div class="glass-panel rounded-[2rem] p-6 min-h-[300px]">
                    <div class="flex justify-between items-center mb-6">
                        <h2 class="text-white text-lg font-bold">Live Lobbies</h2>
                        <span class="flex h-3 w-3 relative">
                            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-violet-400 opacity-75"></span>
                            <span class="relative inline-flex rounded-full h-3 w-3 bg-violet-500"></span>
                        </span>
                    </div>

                    <% if (publicBets && publicBets.length > 0) { %>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <% publicBets.forEach(bet => { %>
                                <div class="bg-black/30 border border-white/5 hover:border-violet-500/50 rounded-2xl p-5 relative overflow-hidden group transition-all">
                                    <div class="absolute top-0 right-0 p-4 opacity-5 group-hover:opacity-10 transition-opacity">
                                        <svg class="w-16 h-16" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>
                                    </div>
                                    
                                    <div class="flex justify-between items-start mb-6 relative z-10">
                                        <div>
                                            <span class="px-2 py-1 rounded-md text-[10px] font-bold tracking-wider uppercase <%= bet.hostChain === 'SOL' ? 'bg-emerald-500/20 text-emerald-400' : 'bg-blue-500/20 text-blue-400' %> mb-2 inline-block">
                                                <%= bet.hostChain %> Match
                                            </span>
                                            <h3 class="text-white font-bold text-lg capitalize"><%= bet.game %></h3>
                                        </div>
                                        <div class="text-right">
                                            <p class="text-violet-400 font-bold text-xl">$<%= bet.amountUSD.toFixed(2) %></p>
                                            <p class="text-xs text-slate-500"><%= bet.cryptoAmount %> <%= bet.hostChain %></p>
                                        </div>
                                    </div>
                                    
                                    <form action="/trade/join" method="POST" class="relative z-10 m-0">
                                        <input type="hidden" name="betId" value="<%= bet.id %>">
                                        <button type="submit" class="w-full bg-white/5 hover:bg-violet-600 text-white font-semibold text-sm py-3 rounded-xl transition-all">
                                            Join & Play
                                        </button>
                                    </form>
                                </div>
                            <% }) %>
                        </div>
                    <% } else { %>
                        <div class="flex flex-col items-center justify-center py-16 text-slate-500">
                            <svg class="w-16 h-16 mb-4 opacity-50" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 002-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path></svg>
                            <p class="text-sm font-medium">No public lobbies available. Create one to start.</p>
                        </div>
                    <% } %>
                </div>

                <!-- Join Private Match -->
                <div class="glass-panel rounded-3xl p-6 relative">
                    <h2 class="text-slate-300 text-sm font-semibold mb-4">Join Private Match</h2>
                    <form action="/trade/join" method="POST" class="flex flex-col md:flex-row gap-3">
                        <input type="text" name="betId" placeholder="Match ID (Optional)" class="flex-1 bg-black/30 border border-white/10 rounded-xl p-3 text-white text-sm focus:border-violet-500 outline-none transition-all">
                        <input type="text" name="accessKey" placeholder="Secret Key" class="flex-1 bg-black/30 border border-white/10 rounded-xl p-3 text-violet-400 text-sm focus:border-violet-500 outline-none transition-all uppercase placeholder-slate-600">
                        <button type="submit" class="bg-white/10 hover:bg-white/20 text-white font-semibold text-sm py-3 px-8 rounded-xl transition-all">
                            Enter
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <!-- ================= PRACTICE MODE CONTENT ================= -->
        <div id="practice-content" class="hidden grid grid-cols-1 lg:grid-cols-12 gap-6">
            
            <div class="lg:col-span-4 space-y-6">
                <!-- Practice Create Panel -->
                <div class="bg-emerald-950/30 border border-emerald-500/20 rounded-[2rem] p-6 relative overflow-hidden backdrop-blur-md">
                    <div class="absolute top-0 right-0 w-32 h-32 bg-emerald-500/20 rounded-full blur-3xl -translate-y-1/2 translate-x-1/2"></div>
                    
                    <h2 class="text-emerald-400 text-lg font-bold mb-6 flex items-center gap-2">
                        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"></path></svg>
                        Test Arena (No Risk)
                    </h2>
                    
                    <form onsubmit="handlePracticeSubmit(event)" class="space-y-5 relative z-10">
                        <div>
                            <label class="block text-xs font-semibold text-emerald-500 mb-2 uppercase tracking-wide">Play Money</label>
                            <input type="number" value="1000" disabled class="w-full bg-black/40 border border-emerald-500/20 rounded-xl p-4 text-emerald-200 text-lg cursor-not-allowed opacity-70">
                        </div>

                        <div>
                            <label class="block text-xs font-semibold text-emerald-500 mb-2 uppercase tracking-wide">Select Game</label>
                            <select class="w-full bg-black/30 border border-emerald-500/20 rounded-xl p-3 text-white text-sm focus:border-emerald-500 outline-none appearance-none cursor-pointer">
                                <option>🎲 Coinflip Simulation</option>
                                <option>🎯 Dice Roll Simulation</option>
                                <option>🃏 Blackjack Simulation</option>
                            </select>
                        </div>

                        <button type="submit" class="w-full bg-emerald-600 hover:bg-emerald-500 text-white font-bold py-4 rounded-xl shadow-lg shadow-emerald-500/25 transition-transform transform hover:scale-[1.02]">
                            Simulate Match
                        </button>
                    </form>
                </div>
            </div>

            <div class="lg:col-span-8">
                <!-- Practice Information / Empty State -->
                <div class="h-full min-h-[300px] border border-dashed border-emerald-500/30 rounded-[2rem] flex flex-col items-center justify-center text-center p-8 bg-emerald-950/10">
                    <div class="w-20 h-20 bg-emerald-500/10 rounded-full flex items-center justify-center mb-6">
                        <svg class="w-10 h-10 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                    </div>
                    <h3 class="text-2xl font-bold text-white mb-2">Practice Mode Active</h3>
                    <p class="text-slate-400 max-w-md mx-auto">
                        This is a sandbox environment. Play against automated simulated opponents without risking any real cryptocurrency. Great for testing strategies!
                    </p>
                </div>
            </div>

        </div>

    </div>

</body>
</html>
