<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Vault Node | Dashboard</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        // Simple UI script to handle tab switching
        function switchTab(tabId) {
            document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));
            document.querySelectorAll('.tab-btn').forEach(el => {
                el.classList.remove('text-emerald-500', 'border-emerald-500');
                el.classList.add('text-zinc-500', 'border-transparent');
            });
            
            document.getElementById(tabId).classList.remove('hidden');
            const activeBtn = document.getElementById('btn-' + tabId);
            activeBtn.classList.remove('text-zinc-500', 'border-transparent');
            activeBtn.classList.add('text-emerald-500', 'border-emerald-500');
        }
    </script>
</head>
<body class="bg-zinc-950 text-zinc-300 font-sans antialiased min-h-screen selection:bg-emerald-500 selection:text-black p-4 md:p-8">

    <div class="max-w-3xl mx-auto space-y-6">
        
        <header class="flex justify-between items-center bg-zinc-900 border border-zinc-800 p-5 shadow-xl">
            <div class="flex items-center space-x-3">
                <div class="w-2 h-6 bg-emerald-500 shadow-[0_0_10px_rgba(16,185,129,0.5)]"></div>
                <h1 class="text-xl font-bold text-white tracking-widest uppercase">Vault <span class="text-emerald-500">Node</span></h1>
            </div>
            <div class="flex items-center space-x-4">
                <div class="flex items-center space-x-2 text-xs font-mono text-emerald-500">
                    <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                    <span>NETWORK: ONLINE</span>
                </div>
                <form action="/logout" method="POST" class="m-0">
                    <button type="submit" class="text-xs font-mono text-zinc-500 hover:text-red-500 border border-zinc-700 hover:border-red-500 px-3 py-1 uppercase transition-all duration-200">
                        Disconnect
                    </button>
                </form>
            </div>
        </header>

        <nav class="flex space-x-6 border-b border-zinc-800 px-2">
            <button id="btn-portfolio" onclick="switchTab('portfolio')" class="tab-btn px-2 py-3 text-emerald-500 border-b-2 border-emerald-500 font-mono tracking-wide uppercase text-sm transition-colors">Portfolio</button>
            <button id="btn-receive" onclick="switchTab('receive')" class="tab-btn px-2 py-3 text-zinc-500 border-b-2 border-transparent hover:text-zinc-300 font-mono tracking-wide uppercase text-sm transition-colors">Deposit</button>
            <button id="btn-send" onclick="switchTab('send')" class="tab-btn px-2 py-3 text-zinc-500 border-b-2 border-transparent hover:text-zinc-300 font-mono tracking-wide uppercase text-sm transition-colors">Transmit</button>
        </nav>

        <div id="portfolio" class="tab-content space-y-4">
            <div class="bg-zinc-900 border border-zinc-800 p-8 flex flex-col items-center justify-center space-y-2">
                <p class="text-xs text-zinc-500 uppercase tracking-widest font-mono">Total Estimated Value</p>
                <h2 class="text-4xl font-bold text-white tracking-tight">$0.00 <span class="text-lg text-zinc-600">USD</span></h2>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div class="bg-zinc-900 border border-zinc-800 p-5 hover:border-zinc-600 transition-colors">
                    <div class="flex justify-between items-center mb-4">
                        <div class="flex items-center space-x-3">
                            <div class="w-8 h-8 bg-blue-600/20 text-blue-500 rounded flex items-center justify-center font-bold font-mono border border-blue-500/30">Ξ</div>
                            <div>
                                <h3 class="text-white font-semibold">Ethereum</h3>
                                <p class="text-xs text-zinc-500 font-mono">EVM Compatible</p>
                            </div>
                        </div>
                        <div class="text-right">
                            <p class="text-white font-mono">0.000 ETH</p>
                            <p class="text-xs text-zinc-500 font-mono">$0.00</p>
                        </div>
                    </div>
                    <div class="bg-zinc-950 p-2 text-xs font-mono text-zinc-400 truncate border border-zinc-800">
                        <%= wallet.ethAddress %>
                    </div>
                </div>

                <div class="bg-zinc-900 border border-zinc-800 p-5 hover:border-zinc-600 transition-colors">
                    <div class="flex justify-between items-center mb-4">
                        <div class="flex items-center space-x-3">
                            <div class="w-8 h-8 bg-purple-600/20 text-purple-400 rounded flex items-center justify-center font-bold font-mono border border-purple-500/30">S</div>
                            <div>
                                <h3 class="text-white font-semibold">Solana</h3>
                                <p class="text-xs text-zinc-500 font-mono">High Speed</p>
                            </div>
                        </div>
                        <div class="text-right">
                            <p class="text-white font-mono">0.000 SOL</p>
                            <p class="text-xs text-zinc-500 font-mono">$0.00</p>
                        </div>
                    </div>
                    <div class="bg-zinc-950 p-2 text-xs font-mono text-zinc-400 truncate border border-zinc-800">
                        <%= wallet.solAddress %>
                    </div>
                </div>
            </div>

            <div class="mt-8 border border-red-900/50 bg-red-950/10 p-5">
                <p class="text-xs text-red-500 font-mono uppercase mb-2 flex items-center"><span class="w-2 h-2 bg-red-500 mr-2 rounded-full"></span> Classified: Recovery Phrase</p>
                <p class="font-mono text-zinc-400 text-sm leading-loose tracking-wide bg-zinc-950 p-4 border border-zinc-800">
                    <%= wallet.mnemonic %>
                </p>
            </div>
        </div>

        <div id="receive" class="tab-content hidden space-y-6">
            <div class="bg-zinc-900 border border-zinc-800 p-6 text-center">
                <p class="text-sm text-zinc-400 mb-6">Scan QR or copy address to deposit funds. Ensure you select the correct network.</p>
                
                <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                    <div class="flex flex-col items-center space-y-4">
                        <h3 class="text-blue-400 font-mono uppercase tracking-widest text-sm border-b border-zinc-800 w-full pb-2">ETH / EVM Network</h3>
                        <div class="bg-white p-3 rounded-sm">
                            <img src="https://api.qrserver.com/v1/create-qr-code/?size=150x150&data=<%= wallet.ethAddress %>" alt="ETH QR">
                        </div>
                        <code class="w-full bg-zinc-950 p-3 text-xs text-blue-300 font-mono break-all border border-zinc-800">
                            <%= wallet.ethAddress %>
                        </code>
                    </div>

                    <div class="flex flex-col items-center space-y-4">
                        <h3 class="text-purple-400 font-mono uppercase tracking-widest text-sm border-b border-zinc-800 w-full pb-2">Solana Network</h3>
                        <div class="bg-white p-3 rounded-sm">
                            <img src="https://api.qrserver.com/v1/create-qr-code/?size=150x150&data=<%= wallet.solAddress %>" alt="SOL QR">
                        </div>
                        <code class="w-full bg-zinc-950 p-3 text-xs text-purple-300 font-mono break-all border border-zinc-800">
                            <%= wallet.solAddress %>
                        </code>
                    </div>
                </div>
            </div>
        </div>

        <div id="send" class="tab-content hidden">
            <div class="bg-zinc-900 border border-zinc-800 p-6 md:p-8">
                <form class="space-y-6" onsubmit="event.preventDefault(); alert('RPC Endpoints not configured in mock UI.');">
                    
                    <div class="grid grid-cols-2 gap-4">
                        <label class="block cursor-pointer">
                            <input type="radio" name="network" class="peer sr-only" checked>
                            <div class="p-4 border border-zinc-800 text-center font-mono text-sm text-zinc-500 peer-checked:border-blue-500 peer-checked:text-blue-400 hover:bg-zinc-800 transition-colors">
                                ETH Network
                            </div>
                        </label>
                        <label class="block cursor-pointer">
                            <input type="radio" name="network" class="peer sr-only">
                            <div class="p-4 border border-zinc-800 text-center font-mono text-sm text-zinc-500 peer-checked:border-purple-500 peer-checked:text-purple-400 hover:bg-zinc-800 transition-colors">
                                SOL Network
                            </div>
                        </label>
                    </div>

                    <div>
                        <label class="block text-xs font-mono text-zinc-500 uppercase tracking-widest mb-2">Destination Address</label>
                        <input type="text" placeholder="0x... or Base58 Address" class="w-full bg-zinc-950 border border-zinc-800 p-4 text-white font-mono text-sm focus:outline-none focus:border-emerald-500 transition-colors placeholder-zinc-700">
                    </div>

                    <div>
                        <label class="block text-xs font-mono text-zinc-500 uppercase tracking-widest mb-2">Amount</label>
                        <div class="relative">
                            <input type="number" step="any" placeholder="0.00" class="w-full bg-zinc-950 border border-zinc-800 p-4 text-white font-mono text-xl focus:outline-none focus:border-emerald-500 transition-colors placeholder-zinc-800">
                            <button type="button" class="absolute right-4 top-1/2 transform -translate-y-1/2 text-xs font-mono text-emerald-500 hover:text-emerald-400 uppercase">Max</button>
                        </div>
                    </div>

                    <button type="submit" class="w-full bg-emerald-600 hover:bg-emerald-500 text-black font-bold font-mono text-sm py-4 px-4 uppercase tracking-wider transition-colors duration-200 mt-4">
                        Authorize Transfer
                    </button>
                </form>
            </div>
        </div>

    </div>

</body>
</html>
