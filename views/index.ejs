<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Vault Node | Initialize</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-zinc-950 text-zinc-300 font-sans antialiased min-h-screen flex items-center justify-center p-4 selection:bg-emerald-500 selection:text-black">

    <div class="w-full max-w-md bg-zinc-900 border border-zinc-800 shadow-2xl p-8">
        <div class="flex items-center space-x-3 mb-8 border-b border-zinc-800 pb-4">
            <div class="w-2 h-6 bg-emerald-500"></div>
            <h1 class="text-2xl font-bold text-white tracking-widest uppercase">Vault <span class="text-emerald-500">Node</span></h1>
        </div>

        <% if (error) { %>
            <div class="bg-red-950/50 border border-red-500 text-red-400 p-3 mb-6 text-xs font-mono uppercase tracking-wide">
                [!] <%= error %>
            </div>
        <% } %>

        <div class="space-y-8">
            <div>
                <p class="text-xs text-zinc-500 uppercase tracking-widest mb-3">System Initialization</p>
                <form action="/generate" method="POST">
                    <button type="submit" class="w-full bg-zinc-800 hover:bg-zinc-700 text-emerald-500 border border-zinc-700 hover:border-emerald-500 transition-all duration-200 font-mono text-sm py-3 px-4 uppercase tracking-wider">
                        Initialize New Keypair
                    </button>
                </form>
            </div>

            <div class="flex items-center text-zinc-700 text-xs font-mono uppercase">
                <div class="flex-grow border-t border-zinc-800"></div>
                <span class="mx-4">Or</span>
                <div class="flex-grow border-t border-zinc-800"></div>
            </div>

            <div>
                <p class="text-xs text-zinc-500 uppercase tracking-widest mb-3">Load Existing Matrix</p>
                <form action="/import" method="POST" class="space-y-4">
                    <textarea name="mnemonic" rows="3" required placeholder="ENTER 12 OR 24 WORD SEED PHRASE..." class="w-full bg-zinc-950 border border-zinc-800 p-4 text-white font-mono text-sm focus:outline-none focus:border-emerald-500 transition-colors resize-none placeholder-zinc-700"></textarea>
                    <button type="submit" class="w-full bg-emerald-600 hover:bg-emerald-500 text-black font-bold font-mono text-sm py-3 px-4 uppercase tracking-wider transition-colors duration-200">
                        Decrypt & Access
                    </button>
                </form>
            </div>
        </div>
    </div>

</body>
</html>
