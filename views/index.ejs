        }

        // --- 12 MUST VISIT SPOTS & MAP EMBED (Using completely verified fallback-safe Unsplash IDs) ---
        const top12Spots = [
            { name: "Haeundae Beach", query: "Haeundae Beach, Busan, South Korea", desc: "The most famous and lively beach in all of South Korea.", img: "https://images.unsplash.com/photo-1590396009831-279589d71c84?q=80&w=600" },
            { name: "Gamcheon Village", query: "Gamcheon Culture Village, Busan", desc: "A colorful, terraced village often called the 'Machu Picchu of Busan'.", img: "https://images.unsplash.com/photo-1598285523992-3d778fb9df90?q=80&w=600" },
            { name: "Haedong Temple", query: "Haedong Yonggungsa Temple, Busan", desc: "A rare Buddhist temple built directly along the rocky ocean shoreline.", img: "https://images.unsplash.com/photo-1601331776913-94fb572dcc9a?q=80&w=600" },
            { name: "Jagalchi Market", query: "Jagalchi Market, Busan", desc: "Korea's largest seafood market—pick your fish and eat it fresh upstairs.", img: "https://images.unsplash.com/photo-1549467657-37299a915907?q=80&w=600" },
            { name: "Gwangalli Beach", query: "Gwangalli Beach, Busan", desc: "Famous for the massive diamond bridge spanning the horizon.", img: "https://images.unsplash.com/photo-1558588942-930faae5a389?q=80&w=600" },
            { name: "Taejongdae Park", query: "Taejongdae, Busan", desc: "Stunning cliffs facing the open sea, accessible by a cute tram.", img: "https://images.unsplash.com/photo-1647414736371-29e2f4945d8b?q=80&w=600" },
            { name: "Seomyeon Street", query: "Seomyeon, Busan", desc: "The neon-soaked commercial and medical hub of Busan.", img: "https://images.unsplash.com/photo-1616782299863-71a7d6052be0?q=80&w=600" },
            { name: "Gyeongbokgung", query: "Gyeongbokgung Palace, Seoul", desc: "The grandest of the 5 palaces in Seoul. Wear a Hanbok for free entry!", img: "https://images.unsplash.com/photo-1538669715315-181ee7b60bd7?q=80&w=600" },
            { name: "N Seoul Tower", query: "N Seoul Tower", desc: "Iconic tower offering 360-degree views of the sprawling capital.", img: "https://images.unsplash.com/photo-1517154421773-0529f29ea451?q=80&w=600" },
            { name: "Bukchon Village", query: "Bukchon Hanok Village, Seoul", desc: "A beautifully preserved traditional village nestled in modern Seoul.", img: "https://images.unsplash.com/photo-1599815041490-449e0b86a877?q=80&w=600" },
            { name: "Myeongdong", query: "Myeongdong, Seoul", desc: "The ultimate destination for street food and K-beauty shopping.", img: "https://images.unsplash.com/photo-1574003058852-59892ba484a9?q=80&w=600" },
            { name: "Jeju Hallasan", query: "Hallasan, Jeju-do", desc: "The volcanic island getaway, crowned by Korea's highest mountain.", img: "https://images.unsplash.com/photo-1596705626248-735a29910d6a?q=80&w=600" }
        ];

        function renderTop12() {
            const grid = document.getElementById('top-12-grid');
            top12Spots.forEach((spot) => {
                const mapLink = `https://maps.google.com/maps?q=${encodeURIComponent(spot.query)}&t=&z=14&ie=UTF8&iwloc=&output=embed`;
                
                grid.innerHTML += `
                    <div class="bg-white border border-zinc-200 rounded-3xl overflow-hidden hover-lift flex flex-col shadow-sm">
                        <div class="h-48 overflow-hidden bg-zinc-100">
