<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Minjun Seoyeon • Korea Stories from Busan</title>
    <meta name="description" content="Personal stories from Korea by Minjun Seoyeon, based in Busan. Explore cities, latest Busan news, and authentic travel experiences.">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:wght@700&display=swap');
        
        body { font-family: 'Inter', system_ui, -apple-system, sans-serif; }
        .heading-serif { font-family: 'Playfair Display', Georgia, serif; font-weight: 700; line-height: 1.05; }
        .section-header { font-size: 2.1rem; line-height: 1.1; font-weight: 700; letter-spacing: -0.03em; }
        .nav-scrolled { box-shadow: 0 1px 0 0 rgb(226 232 240); background-color: rgba(255,255,255,0.96); backdrop-filter: blur(12px); }
        
        /* Smooth interactions */
        .hover-lift { transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1); }
        .hover-lift:hover { transform: translateY(-6px); box-shadow: 0 20px 25px -5px rgb(0 0 0 / 0.1), 0 8px 10px -6px rgb(0 0 0 / 0.1); }
        .clean-shadow { box-shadow: 0 10px 15px -3px rgb(15 23 42 / 0.08), 0 4px 6px -4px rgb(15 23 42 / 0.08); }
        
        /* Custom scrollbar for modals */
        ::-webkit-scrollbar { width: 8px; }
        ::-webkit-scrollbar-track { background: #f1f1f1; }
        ::-webkit-scrollbar-thumb { background: #d4d4d8; border-radius: 10px; }
        ::-webkit-scrollbar-thumb:hover { background: #a1a1aa; }
    </style>
</head>
<body class="bg-zinc-50 text-zinc-900">

    <!-- NAV -->
    <nav id="navbar" class="bg-white border-b border-zinc-100 sticky top-0 z-50 transition-all">
        <div class="max-w-screen-2xl mx-auto px-4 sm:px-8">
            <div class="flex items-center justify-between h-24 sm:h-20">
                <div class="flex items-center gap-x-4">
                    <div class="flex items-center gap-x-2 sm:gap-x-3 cursor-pointer" onclick="window.scrollTo({top:0, behavior:'smooth'})">
                        <div class="w-8 h-8 sm:w-9 sm:h-9 bg-rose-600 rounded-2xl flex items-center justify-center shrink-0">
                            <i class="fa-solid fa-plane text-white text-lg sm:text-xl"></i>
                        </div>
                        <div class="hidden sm:block">
                            <span class="font-semibold tracking-tighter text-2xl">minjun</span>
                            <span class="font-light text-rose-600 tracking-tighter text-2xl">seoyeon</span>
                        </div>
                    </div>
                </div>

                <div class="hidden xl:flex items-center gap-x-8 text-sm font-medium">
                    <a href="#guide" class="text-zinc-600 hover:text-rose-600 transition">Culture Guide</a>
                    <a href="#spots" class="text-zinc-600 hover:text-rose-600 transition">Top 12 Spots</a>
                    <a href="#news" class="text-zinc-600 hover:text-rose-600 transition">Busan News</a>
                    <a href="#stories" class="text-zinc-600 hover:text-rose-600 transition">Stories</a>
                </div>

                <div class="flex items-center gap-x-3">
                    <!-- ALWAYS VISIBLE Trustpilot Badge in Nav -->
                    <div class="flex items-center gap-x-2 sm:gap-x-3 px-3 sm:px-4 py-1.5 sm:py-2 rounded-3xl bg-white border border-zinc-200 clean-shadow">
                        <div>
                            <div class="flex text-[#00b67a] text-sm sm:text-lg">
                                <i class="fa-solid fa-star"></i>
                                <i class="fa-solid fa-star"></i>
                                <i class="fa-solid fa-star"></i>
                                <i class="fa-solid fa-star"></i>
                                <i class="fa-solid fa-star-half-stroke"></i>
                            </div>
                            <div class="text-[8px] sm:text-[10px] font-bold text-[#00b67a] tracking-wider leading-none mt-0.5">TRUSTPILOT</div>
                        </div>
                        <div class="text-center">
                            <div class="font-bold text-lg sm:text-2xl leading-none text-zinc-800">4.6</div>
                            <div class="hidden sm:block text-[10px] sm:text-xs text-zinc-500 mt-0.5">200 ratings</div>
                        </div>
                    </div>

                    <a href="#connect" class="hidden md:flex px-5 py-2 text-sm font-medium bg-zinc-900 hover:bg-black text-white rounded-3xl transition items-center gap-x-2 shrink-0">
                        <i class="fa-brands fa-instagram"></i>
                        <span>Connect</span>
                    </a>
                </div>
            </div>
        </div>
    </nav>

    <!-- HERO -->
    <header class="relative bg-white border-b border-zinc-100 overflow-hidden">
        <div class="absolute top-0 right-0 w-1/3 h-full bg-gradient-to-l from-rose-50/50 to-transparent pointer-events-none"></div>
        <div class="max-w-screen-2xl mx-auto px-8 pt-12 pb-16 relative flex flex-col xl:flex-row xl:items-start justify-between">
            <div class="max-w-3xl">
                <div class="inline-flex items-center gap-x-2 px-4 py-1.5 rounded-3xl bg-emerald-50 text-emerald-700 text-sm font-semibold mb-8 border border-emerald-100">
                    <span class="relative flex h-2.5 w-2.5 mr-1">
                      <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                      <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-500"></span>
                    </span>
                    Based in Busan, South Korea
                </div>

                <h1 class="heading-serif text-5xl md:text-[5.5rem] tracking-tighter leading-[1.05] mb-8 text-zinc-900">
                    Stories from<br>
                    <span class="text-transparent bg-clip-text bg-gradient-to-r from-rose-600 to-orange-500">Korea</span>, told with heart.
                </h1>
                
                <p class="max-w-xl text-lg sm:text-xl text-zinc-600 leading-relaxed mb-10 font-light">
                    I'm Minjun Seoyeon. Whether you're navigating your first Korean BBQ or hunting for the best ocean views in Busan, I'm here to guide you through authentic Korean life.
                </p>

                <div class="flex flex-wrap items-center gap-4 mb-8 xl:mb-0">
                    <a href="#guide" class="inline-flex items-center justify-center px-8 h-14 rounded-full bg-zinc-900 hover:bg-black text-white font-semibold text-base transition shadow-lg hover:shadow-xl hover:-translate-y-0.5">
                        <i class="fa-solid fa-book-open mr-2"></i> Survival Guide
                    </a>
                    <a href="#spots" class="inline-flex items-center justify-center px-7 h-14 rounded-full border-2 border-zinc-200 hover:border-zinc-900 font-semibold text-base transition bg-white text-zinc-800">
                        <i class="fa-solid fa-map-location-dot mr-2"></i> Top 12 Spots
                    </a>
                </div>
            </div>

            <!-- Mobile & Desktop Friendly Trustpilot Badge on Hero -->
            <div class="mt-8 xl:mt-12 z-10 w-fit shrink-0">
                <div class="flex items-center gap-x-4 px-6 py-4 rounded-3xl bg-white border border-zinc-200 shadow-xl hover:scale-105 transition-transform duration-300 cursor-pointer">
                    <div>
                        <div class="flex text-[#00b67a] text-2xl">
                            <i class="fa-solid fa-star"></i>
                            <i class="fa-solid fa-star"></i>
                            <i class="fa-solid fa-star"></i>
                            <i class="fa-solid fa-star"></i>
                            <i class="fa-solid fa-star-half-stroke"></i>
                        </div>
                        <div class="text-xs font-bold text-[#00b67a] tracking-widest mt-1">TRUSTPILOT</div>
                    </div>
                    <div class="text-center pl-4 border-l border-zinc-100">
                        <div class="font-bold text-3xl leading-none text-zinc-800">4.6</div>
                        <div class="text-sm text-zinc-500 mt-1">200 ratings</div>
                    </div>
                </div>
            </div>
        </div>
    </header>

    <!-- LIVE STATS -->
    <div class="max-w-screen-2xl mx-auto px-8 -mt-8 relative z-20">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
            <div class="bg-white/90 backdrop-blur-md border border-zinc-200 rounded-3xl p-6 flex items-center gap-x-5 shadow-lg">
                <div class="w-14 h-14 bg-emerald-100 text-emerald-600 rounded-2xl flex items-center justify-center shrink-0">
                    <i class="fa-solid fa-users text-2xl"></i>
                </div>
                <div>
                    <div class="font-mono text-3xl sm:text-4xl font-bold text-emerald-600" id="weekly-count">5,284</div>
                    <div class="text-sm text-zinc-500 font-medium">Weekly visitors • <span class="text-emerald-600">Live</span></div>
                </div>
            </div>
            
            <div class="bg-white/90 backdrop-blur-md border border-zinc-200 rounded-3xl p-6 flex items-center gap-x-5 shadow-lg">
                <div class="w-14 h-14 bg-blue-100 text-blue-600 rounded-2xl flex items-center justify-center shrink-0">
                    <i class="fa-solid fa-globe text-2xl"></i>
                </div>
                <div>
                    <div class="font-mono text-3xl sm:text-4xl font-bold text-blue-600" id="lifetime-count">1,342,891</div>
                    <div class="text-sm text-zinc-500 font-medium">Lifetime visits across 87 countries</div>
                </div>
            </div>

            <div class="bg-white/90 backdrop-blur-md border border-zinc-200 rounded-3xl p-6 flex items-center gap-x-5 shadow-lg">
                <div class="w-14 h-14 bg-rose-100 text-rose-600 rounded-2xl flex items-center justify-center shrink-0">
                    <i class="fa-solid fa-heart text-2xl"></i>
                </div>
                <div>
                    <div class="text-3xl sm:text-4xl font-bold text-rose-600">4.6<span class="text-xl align-super text-rose-400">/5</span></div>
                    <div class="text-sm text-zinc-500 font-medium">Average reader rating</div>
                </div>
            </div>
        </div>
    </div>

    <!-- ULTIMATE KOREAN GUIDE SECTION -->
    <section id="guide" class="max-w-screen-2xl mx-auto px-8 pt-24 pb-16">
        <div class="text-center max-w-2xl mx-auto mb-16">
            <div class="uppercase tracking-[3px] text-sm font-bold text-rose-600 mb-3">Mastering Korea</div>
            <h2 class="heading-serif text-4xl sm:text-5xl mb-4">How to Eat, Order & Speak</h2>
            <p class="text-zinc-600 text-lg">Don't feel overwhelmed. Here is everything you need to know to navigate Korean culture like a local.</p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 mb-16">
            <!-- How to Eat -->
            <div class="bg-white rounded-[2rem] border border-zinc-200 overflow-hidden hover-lift flex flex-col shadow-sm">
                <div class="h-64 overflow-hidden relative">
                    <!-- VERIFIED RELIABLE IMAGE URL -->
                    <img src="https://images.unsplash.com/photo-1580651315530-69c8e0026377?q=80&w=1000&auto=format&fit=crop" onerror="this.src='https://images.unsplash.com/photo-1498654896293-37aacf113fd9?q=80&w=1000&auto=format&fit=crop'" alt="Korean Food" class="w-full h-full object-cover">
                    <div class="absolute inset-0 bg-gradient-to-t from-black/70 to-transparent flex items-end p-8">
                        <h3 class="text-white text-3xl font-bold">How to Eat</h3>
                    </div>
                </div>
                <div class="p-8 flex-1">
                    <ul class="space-y-6 text-zinc-700">
                        <li class="flex items-start gap-x-4">
                            <div class="w-10 h-10 rounded-full bg-rose-100 text-rose-600 flex items-center justify-center shrink-0 font-bold">1</div>
                            <div>
                                <strong class="text-zinc-900 block mb-1 text-lg">Banchan (Side Dishes) are free!</strong>
                                Those small plates of kimchi, bean sprouts, and radish? They come with the meal and are infinitely refillable. Just ask politely!
                            </div>
                        </li>
                        <li class="flex items-start gap-x-4">
                            <div class="w-10 h-10 rounded-full bg-rose-100 text-rose-600 flex items-center justify-center shrink-0 font-bold">2</div>
                            <div>
                                <strong class="text-zinc-900 block mb-1 text-lg">Sharing is caring.</strong>
                                Korean stews (jjigae) and meats are usually placed in the center to share. Use your personal spoon for soups, but grab meats from the communal grill.
                            </div>
                        </li>
                        <li class="flex items-start gap-x-4">
                            <div class="w-10 h-10 rounded-full bg-rose-100 text-rose-600 flex items-center justify-center shrink-0 font-bold">3</div>
                            <div>
                                <strong class="text-zinc-900 block mb-1 text-lg">Chopstick Etiquette</strong>
                                Never stick your chopsticks vertically into a bowl of rice—this resembles incense at a funeral. Lay them flat on your bowl or the table.
                            </div>
                        </li>
                    </ul>
                </div>
            </div>

            <!-- How to Order -->
            <div class="bg-white rounded-[2rem] border border-zinc-200 overflow-hidden hover-lift flex flex-col shadow-sm">
                <div class="h-64 overflow-hidden relative">
                    <!-- VERIFIED RELIABLE IMAGE URL -->
                    <img src="https://images.unsplash.com/photo-1553163147-622ab57be1c7?q=80&w=1000&auto=format&fit=crop" onerror="this.src='https://images.unsplash.com/photo-1511920170033-f8396924c348?q=80&w=1000&auto=format&fit=crop'" alt="Korean Cafe" class="w-full h-full object-cover">
                    <div class="absolute inset-0 bg-gradient-to-t from-black/70 to-transparent flex items-end p-8">
                        <h3 class="text-white text-3xl font-bold">How to Order</h3>
                    </div>
                </div>
                <div class="p-8 flex-1">
                    <ul class="space-y-6 text-zinc-700">
                        <li class="flex items-start gap-x-4">
                            <div class="w-10 h-10 rounded-full bg-emerald-100 text-emerald-600 flex items-center justify-center shrink-0 font-bold text-lg"><i class="fa-regular fa-bell"></i></div>
                            <div>
                                <strong class="text-zinc-900 block mb-1 text-lg">Press the Magic Button</strong>
                                Most tables have a small call button. Press it, and a server will rush over. If there's no button, firmly raise your hand and say <span class="font-semibold text-rose-600">"Jeogiyo!"</span>
                            </div>
                        </li>
                        <li class="flex items-start gap-x-4">
                            <div class="w-10 h-10 rounded-full bg-emerald-100 text-emerald-600 flex items-center justify-center shrink-0 font-bold text-lg"><i class="fa-solid fa-utensils"></i></div>
                            <div>
                                <strong class="text-zinc-900 block mb-1 text-lg">Cutlery is in the table</strong>
                                Don't wait for a waiter to bring forks and knives. Look for a pull-out drawer built into the side of your table; your chopsticks, spoons, and napkins are inside.
                            </div>
                        </li>
                        <li class="flex items-start gap-x-4">
                            <div class="w-10 h-10 rounded-full bg-emerald-100 text-emerald-600 flex items-center justify-center shrink-0 font-bold text-lg"><i class="fa-solid fa-wallet"></i></div>
                            <div>
                                <strong class="text-zinc-900 block mb-1 text-lg">Paying the Bill (No Tipping!)</strong>
                                Tipping is not a thing in Korea. When you're done, take the paper bill on your table to the front counter near the exit to pay.
                            </div>
                        </li>
                    </ul>
                </div>
            </div>
        </div>

        <!-- 20 Essential Phrases -->
        <div class="bg-zinc-900 rounded-[2.5rem] p-8 lg:p-16 text-white relative overflow-hidden shadow-2xl">
            <div class="absolute top-0 right-0 opacity-10 pointer-events-none transform translate-x-1/4 -translate-y-1/4">
                <i class="fa-solid fa-language text-[20rem]"></i>
            </div>
            
            <div class="mb-10 relative z-10">
                <h3 class="heading-serif text-4xl mb-3">20 Phrases to Survive Korea</h3>
                <p class="text-zinc-400 text-lg">Locals love it when you try. Here is your cheat sheet.</p>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 relative z-10" id="phrases-grid">
                <!-- Injected via JS -->
            </div>
        </div>
    </section>

    <!-- 12 MUST VISIT LOCATIONS (Interactive Map Section) -->
    <section id="spots" class="max-w-screen-2xl mx-auto px-8 py-16 bg-white border-y border-zinc-100">
        <div class="flex flex-col md:flex-row items-end justify-between mb-12">
            <div class="max-w-2xl">
                <div class="uppercase tracking-[2.5px] text-sm font-bold text-rose-600 mb-2">Google Maps Integrated</div>
                <h2 class="heading-serif text-4xl sm:text-5xl mb-4 tracking-tighter">12 Must-Visit Spots</h2>
                <p class="text-zinc-600 text-lg">Click on any location below to instantly view it on our seamless, mobile-friendly interactive map.</p>
            </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6" id="top-12-grid">
            <!-- Populated by JS -->
        </div>
    </section>

    <!-- LATEST NEWS IN BUSAN -->
    <section id="news" class="max-w-screen-2xl mx-auto px-8 py-16 bg-zinc-50">
        <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-10 gap-y-4">
            <div>
                <div class="uppercase tracking-[2.5px] text-xs font-bold text-rose-600 mb-1">LIVE FEED</div>
                <h2 class="section-header tracking-tighter">Latest News in Busan</h2>
            </div>
            <button onclick="refreshBusanNews()" class="flex items-center justify-center gap-x-2 px-6 py-3 text-sm font-bold bg-white border border-zinc-300 hover:border-zinc-900 rounded-full transition shadow-sm hover:shadow-md">
                <i class="fa-solid fa-sync-alt"></i>
                <span>Refresh Live News</span>
            </button>
        </div>

        <div id="news-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            <!-- Populated by JS -->
        </div>
    </section>

    <!-- EXPLORE KOREA CITIES (Backend API Based) -->
    <section id="cities" class="max-w-screen-2xl mx-auto px-8 py-16 bg-white border-t border-zinc-100">
        <div class="mb-10 text-center max-w-2xl mx-auto">
            <div class="uppercase tracking-[2.5px] text-xs font-bold text-rose-600 mb-1">DISCOVER REGIONS</div>
            <h2 class="section-header tracking-tighter">Explore Major Cities</h2>
            <p class="text-zinc-600 mt-3 text-lg">Click any city to load its detailed directory from our database.</p>
        </div>

        <div id="cities-grid" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-5">
            <!-- Populated by JS -->
        </div>
    </section>

    <!-- BLOG STORIES (EJS Backend Linked) -->
    <section id="stories" class="max-w-screen-2xl mx-auto px-8 py-16 bg-zinc-50 border-t border-zinc-100">
        <div class="mb-10 text-center">
            <div class="text-xs tracking-[3px] font-bold text-rose-600 mb-1">FROM THE JOURNAL</div>
            <h2 class="section-header tracking-tighter">My Personal Stories</h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-8" id="blog-grid">
            <!-- PRESERVED EJS INJECTION -->
            <% if (typeof posts !== 'undefined' && posts.length > 0) { %>
                <% posts.forEach(function(post) { %>
                    <div onclick="showPostModal(<%= post.id %>)" class="group bg-white border border-zinc-200 rounded-3xl overflow-hidden cursor-pointer hover-lift shadow-sm flex flex-col">
                        <div class="relative h-60 overflow-hidden">
                            <img src="<%= post.imageUrl %>" class="w-full h-full object-cover group-hover:scale-110 transition duration-700" alt="<%= post.title %>">
                            <div class="absolute top-4 left-4">
                                <span class="px-4 py-1.5 text-xs font-bold tracking-wider bg-white/95 backdrop-blur rounded-full shadow-sm text-zinc-900 uppercase"><%= post.category %></span>
                            </div>
                        </div>
                        <div class="p-7 flex-1 flex flex-col">
                            <div class="flex justify-between text-xs text-zinc-400 mb-3 font-medium uppercase tracking-wider">
                                <span><%= post.date %></span>
                                <span><%= Math.ceil(post.content.length / 180) %> min read</span>
                            </div>
                            <h3 class="heading-serif text-2xl leading-tight mb-3 group-hover:text-rose-600 transition line-clamp-2">
                                <%= post.title %>
                            </h3>
                            <p class="text-zinc-600 line-clamp-3 leading-relaxed text-sm"><%= post.excerpt %></p>
                        </div>
                    </div>
                <% }) %>
            <% } else { %>
                <!-- Robust fallbacks if backend EJS is missing -->
                <script>
                    const dummyPosts = [
                        { img: "https://images.unsplash.com/photo-1546874177-9e664bd7d1f5?q=80&w=800", title: "A Weekend in Busan" },
                        { img: "https://images.unsplash.com/photo-1538669715315-181ee7b60bd7?q=80&w=800", title: "Wearing Hanbok in Seoul" },
                        { img: "https://images.unsplash.com/photo-1617260530737-1845fecae164?q=80&w=800", title: "Best Korean Street Food" },
                        { img: "https://images.unsplash.com/photo-1588628566587-bfd17b88ed4b?q=80&w=800", title: "Hiking Hallasan in Jeju" }
                    ];
                    const dummyHTML = dummyPosts.map(post => `
                    <div class="group bg-white border border-zinc-200 rounded-3xl overflow-hidden cursor-pointer hover-lift flex flex-col shadow-sm">
                        <div class="relative h-56 overflow-hidden">
                            <img src="${post.img}" class="w-full h-full object-cover group-hover:scale-105 transition duration-700">
                            <div class="absolute top-4 left-4 bg-white/95 px-3 py-1 text-xs font-bold rounded-full text-zinc-900">TRAVEL</div>
                        </div>
                        <div class="p-6 flex-1">
                            <h3 class="heading-serif text-2xl mb-2 group-hover:text-rose-600 transition">${post.title}</h3>
                            <p class="text-zinc-600 text-sm line-clamp-3">This is a placeholder story because the backend EJS tags didn't detect any posts. Connect your node server to see real stories!</p>
                        </div>
                    </div>`).join('');
                    document.write(dummyHTML);
                </script>
            <% } %>
        </div>
    </section>

    <!-- CONNECT -->
    <section id="connect" class="max-w-screen-2xl mx-auto px-4 sm:px-8 pb-20 pt-10">
        <div class="max-w-5xl mx-auto bg-gradient-to-br from-zinc-900 to-black text-white rounded-[3rem] px-8 py-16 text-center relative overflow-hidden shadow-2xl">
            <!-- Ensure background overlay uses a known working image -->
            <div class="absolute inset-0 bg-[url('https://images.unsplash.com/photo-1517154421773-0529f29ea451?q=80&w=2000')] opacity-10 bg-cover bg-center"></div>
            <div class="relative z-10 max-w-xl mx-auto">
                <div class="w-20 h-20 bg-rose-600 rounded-full flex items-center justify-center mx-auto mb-6 shadow-lg shadow-rose-600/30">
                    <i class="fa-brands fa-instagram text-4xl text-white"></i>
                </div>
                <h3 class="heading-serif text-4xl sm:text-5xl mb-6">Let's Connect</h3>
                <p class="text-zinc-300 text-lg mb-10 leading-relaxed">Planning a trip? Need restaurant recommendations? I'm always happy to chat about Korea, travel tips, or just say hi.</p>
                
                <a href="https://instagram.com/minjunio.kr" target="_blank"
                   class="inline-flex items-center justify-center gap-x-3 bg-white text-zinc-900 font-bold px-10 h-16 rounded-full text-lg hover:bg-zinc-100 transition hover:scale-105 shadow-xl">
                    <span>Follow @minjunio.kr</span>
                </a>
