                            <button onclick="openMapModal('${spot.name.replace(/'/g, "\\'")}', '${mapLink}', '${spot.desc.replace(/'/g, "\\'")}')" 
                                    class="w-full py-3 bg-zinc-50 hover:bg-zinc-900 text-zinc-900 hover:text-white font-bold text-sm rounded-xl transition border border-zinc-200 flex items-center justify-center gap-x-2">
                                <i class="fa-solid fa-map-location-dot"></i>
                                View on Map
                            </button>
