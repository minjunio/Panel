        function openMapModal(name, mapUrl, desc) {
            document.getElementById('map-modal-title').textContent = name;
            document.getElementById('map-modal-desc').textContent = desc;
            document.getElementById('map-loader').style.display = 'flex';
            
            const iframe = document.getElementById('map-modal-iframe');
            iframe.src = mapUrl;

            const modal = document.getElementById('interactive-map-modal');
            modal.classList.remove('hidden');
            modal.classList.add('flex');
            document.body.style.overflow = 'hidden';
        }

        function closeMapModal() {
            const modal = document.getElementById('interactive-map-modal');
            modal.classList.remove('flex');
            modal.classList.add('hidden');
            document.getElementById('map-modal-iframe').src = '';
            document.body.style.overflow = 'auto';
        }

        // --- BUSAN NEWS (API Based) ---
        let currentNews = [];
        async function loadBusanNews() {
            try {
                const res = await fetch('/api/busan-news');
                if(!res.ok) throw new Error("API not found");
                currentNews = await res.json();
                renderNews();
            } catch (e) {
                currentNews = [
                    { category: "EVENT", date: "Today", title: "Busan International Film Festival Announces Dates", summary: "The annual BIFF is preparing for its biggest year yet, taking over Haeundae." },
                    { category: "WEATHER", date: "Yesterday", title: "Typhoon Warning Lifted for Southern Coast", summary: "Ferries to Jeju and Fukuoka have resumed operations as weather clears up." },
                    { category: "FOOD", date: "2 Days Ago", title: "New Michelin Guide Highlights Gukbap Alley", summary: "Three local Dwaeji Gukbap (Pork Soup) spots have been awarded Bib Gourmand status." }
                ];
                renderNews();
            }
        }

        function renderNews() {
            const container = document.getElementById('news-grid');
            container.innerHTML = '';
            currentNews.forEach(news => {
                const card = document.createElement('div');
                card.className = `news-card bg-white border border-zinc-200 rounded-3xl p-7 cursor-pointer hover-lift shadow-sm`;
                card.innerHTML = `
                    <div class="flex justify-between items-center mb-4">
                        <span class="px-3.5 py-1 text-xs font-bold rounded-full bg-zinc-100 text-rose-600 tracking-wider">${news.category}</span>
                        <span class="text-xs font-medium text-zinc-400"><i class="fa-regular fa-clock mr-1"></i>${news.date}</span>
                    </div>
                    <h4 class="font-bold text-xl leading-snug tracking-tight mb-3 line-clamp-2">${news.title}</h4>
                    <p class="text-zinc-500 line-clamp-3 mb-5 leading-relaxed text-sm">${news.summary}</p>
                    <div class="text-sm text-zinc-900 font-bold flex items-center gap-x-2">
                        Read full story <i class="fa-solid fa-arrow-right text-xs"></i>
                    </div>
                `;
                card.onclick = () => showNewsModal(news);
                container.appendChild(card);
            });
        }

        function showNewsModal(news) {
            document.getElementById('news-modal-title').textContent = news.title;
            document.getElementById('news-modal-date').textContent = `${news.date}`;
            document.getElementById('news-modal-summary').textContent = news.summary;
            document.getElementById('news-modal-category').textContent = news.category;
            
            const modal = document.getElementById('news-modal');
            modal.classList.remove('hidden');
            modal.classList.add('flex');
            document.body.style.overflow = 'hidden';
        }

        function hideNewsModal() {
            const modal = document.getElementById('news-modal');
            modal.classList.remove('flex');
            modal.classList.add('hidden');
            document.body.style.overflow = 'auto';
        }

        async function refreshBusanNews() {
            const btn = document.querySelector('button[onclick="refreshBusanNews()"]');
            btn.innerHTML = `<i class="fa-solid fa-circle-notch fa-spin"></i> <span>Updating...</span>`;
            
            try {
                const res = await fetch('/api/busan-news/refresh', { method: 'POST' });
                if(res.ok) {
                    const data = await res.json();
                    currentNews = data.news;
                }
            } catch (e) {
                await new Promise(r => setTimeout(r, 800)); // Fake network delay
            }
            
            renderNews();
            btn.innerHTML = `<i class="fa-solid fa-sync-alt"></i> <span>Refresh Live News</span>`;

            const toast = document.createElement('div');
            toast.className = 'fixed bottom-8 right-8 bg-zinc-900 text-white px-6 py-4 rounded-2xl text-sm font-bold flex items-center gap-x-3 z-[500] shadow-2xl animate-[fadeIn_0.3s_ease-out]';
            toast.innerHTML = `<i class="fa-solid fa-check text-emerald-400 text-lg"></i> <span>Feed updated instantly</span>`;
            document.body.appendChild(toast);
            setTimeout(() => {
                toast.style.opacity = '0';
                toast.style.transition = 'opacity 0.3s';
                setTimeout(() => toast.remove(), 300);
            }, 2500);
        }

        // --- KOREA CITIES (API Based) ---
        async function loadCities() {
            try {
                const res = await fetch('/api/cities');
                if(!res.ok) throw new Error("API not found");
                const cities = await res.json();
                renderCities(cities);
            } catch (e) {
                const dummyCities = [
                    { name: "Seoul", description: "The bustling capital.", spots: [{name: "Myeongdong", rating: 4.5, description: "Shopping hub.", mapQuery: "Myeongdong, Seoul"}] },
                    { name: "Busan", description: "Coastal beauty.", spots: [{name: "Haeundae", rating: 5, description: "Famous beach.", mapQuery: "Haeundae Beach"}] },
                    { name: "Jeju", description: "Volcanic paradise.", spots: [{name: "Hallasan", rating: 5, description: "Tallest mountain.", mapQuery: "Hallasan"}] },
                    { name: "Gyeongju", description: "Museum without walls.", spots: [{name: "Bulguksa", rating: 4.8, description: "Historic temple.", mapQuery: "Bulguksa"}] },
                    { name: "Jeonju", description: "Hanok village & food.", spots: [{name: "Hanok Village", rating: 4.6, description: "Traditional houses.", mapQuery: "Jeonju Hanok Village"}] },
                    { name: "Incheon", description: "Gateway to Korea.", spots: [{name: "Chinatown", rating: 4.3, description: "Historic chinatown.", mapQuery: "Incheon Chinatown"}] }
                ];
                renderCities(dummyCities);
            }
        }

        function renderCities(cities) {
            const container = document.getElementById('cities-grid');
            container.innerHTML = '';
            cities.forEach(city => {
                const card = document.createElement('div');
                card.className = `bg-white border border-zinc-200 rounded-3xl p-5 cursor-pointer hover-lift shadow-sm`;
                card.innerHTML = `
                    <div class="font-bold text-xl tracking-tight mb-2">${city.name}</div>
                    <div class="text-sm text-zinc-500 line-clamp-2 mb-4">${city.description}</div>
                    <div class="text-xs text-rose-600 font-bold uppercase tracking-wide flex items-center gap-x-1">
                        View Spots <i class="fa-solid fa-arrow-right"></i>
                    </div>
                `;
                card.onclick = () => showCityModal(city);
                container.appendChild(card);
            });
        }

        function showCityModal(city) {
            document.getElementById('city-modal-name').textContent = city.name;
            document.getElementById('city-modal-desc').textContent = city.description;

            const spotsContainer = document.getElementById('city-modal-spots');
            spotsContainer.innerHTML = '';

            city.spots.forEach(spot => {
                const fullStars = Math.floor(spot.rating);
                const hasHalf = (spot.rating % 1) !== 0;
                let starsHTML = '';
                for (let i = 0; i < fullStars; i++) starsHTML += '<i class="fa-solid fa-star text-[#00b67a]"></i>';
                if (hasHalf) starsHTML += '<i class="fa-solid fa-star-half-stroke text-[#00b67a]"></i>';
                const empty = 5 - Math.ceil(spot.rating);
                for (let i = 0; i < empty; i++) starsHTML += '<i class="fa-regular fa-star text-zinc-300"></i>';

                const div = document.createElement('div');
                div.className = `mb-6 border border-zinc-200 rounded-[1.5rem] p-6 bg-zinc-50`;
                div.innerHTML = `
                    <div class="mb-3">
                        <h4 class="font-bold text-2xl tracking-tight mb-1">${spot.name}</h4>
                        <div class="flex items-center gap-x-2">
                            <div class="flex text-lg">${starsHTML}</div>
                            <span class="font-bold text-zinc-700">${spot.rating}</span>
                        </div>
                    </div>
                    <p class="text-zinc-600 leading-relaxed mb-6 text-sm">${spot.description}</p>
                    <button onclick="openGoogleMaps('${spot.mapQuery}'); event.stopImmediatePropagation();"
                            class="w-full px-6 py-3.5 text-sm font-bold bg-white border-2 border-zinc-200 hover:border-zinc-900 rounded-xl flex items-center justify-center gap-x-2 transition">
                        <i class="fa-solid fa-map-marker-alt text-rose-600"></i>
                        <span>Open in Google Maps App</span>
                    </button>
                `;
                spotsContainer.appendChild(div);
            });

            const modal = document.getElementById('city-modal');
            modal.classList.remove('hidden');
            modal.classList.add('flex');
            document.body.style.overflow = 'hidden';
        }

        function hideCityModal() {
            const modal = document.getElementById('city-modal');
            modal.classList.remove('flex');
            modal.classList.add('hidden');
            document.body.style.overflow = 'auto';
        }

        function openGoogleMaps(query) {
            const url = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(query)}`;
            window.open(url, '_blank');
        }

        function showPostModal(postId) {
            fetch('/api/posts')
                .then(res => {
                    if(!res.ok) throw new Error("No backend");
                    return res.json();
                })
                .then(posts => {
                    const post = posts.find(p => p.id === postId);
                    if (!post) return;
                    renderPostHtml(post);
                })
                .catch(e => {
                    const dummyPost = {
                        category: "Travel",
                        imageUrl: "https://images.unsplash.com/photo-1546874177-9e664bd7d1f5?q=80&w=1200",
                        title: "A Weekend in Busan (Sample)",
                        date: "July 2026",
                        content: "## Welcome to Busan\n\nThis is a sample post. Connect your backend server to load real markdown content via the `/api/posts` endpoint."
                    };
                    renderPostHtml(dummyPost);
                });
        }

        function renderPostHtml(post) {
            const contentHtml = marked ? marked.parse(post.content) : post.content;
            const modalHTML = `
                <div id="post-modal-wrap" onclick="this.remove(); document.body.style.overflow='auto';" class="fixed inset-0 bg-zinc-900/90 backdrop-blur-md z-[500] flex items-start justify-center p-4 sm:p-8 overflow-y-auto">
                    <div onclick="event.stopImmediatePropagation()" class="bg-white w-full max-w-4xl rounded-[2rem] overflow-hidden shadow-2xl my-auto animate-[fadeIn_0.3s_ease-out]">
                        <div class="relative h-72 sm:h-96 bg-zinc-100">
                            <img src="${post.imageUrl}" onerror="this.src='https://picsum.photos/seed/post/1200/800'" class="w-full h-full object-cover" alt="">
                            <button onclick="document.getElementById('post-modal-wrap').remove(); document.body.style.overflow='auto';" class="absolute top-6 right-6 w-10 h-10 bg-white/20 hover:bg-white/40 backdrop-blur-md text-white rounded-full flex items-center justify-center transition text-xl">
                                <i class="fa-solid fa-times"></i>
                            </button>
                            <div class="absolute bottom-6 left-6 sm:left-10">
                                <span class="px-4 py-1.5 text-xs font-bold rounded-full bg-rose-600 text-white uppercase tracking-wider shadow-lg">${post.category}</span>
                            </div>
                        </div>
                        <div class="p-6 sm:p-10">
                            <h1 class="heading-serif text-4xl sm:text-5xl tracking-tighter mb-4">${post.title}</h1>
                            <div class="text-sm font-bold text-zinc-400 mb-8 uppercase tracking-wider">${post.date} • ${Math.ceil(post.content.length / 180)} min read</div>
                            <div class="prose prose-zinc prose-lg max-w-none prose-headings:font-serif prose-headings:tracking-tight">${contentHtml}</div>
                        </div>
                    </div>
                </div>
            `;
            document.body.insertAdjacentHTML('beforeend', modalHTML);
            document.body.style.overflow = 'hidden';
        }

        function initializeBlog() {
            initializeTailwind();
            initNavbar();
            initLiveStats();
            loadBusanNews();
            loadCities();
            renderPhrases();
            renderTop12();
        }

        window.onload = initializeBlog;
    </script>
</body>
</html>
